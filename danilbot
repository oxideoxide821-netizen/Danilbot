def init_db():
    conn = sqlite3.connect('market.db', check_same_thread=False)
    c = conn.cursor()
    c.executescript('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            balance INTEGER DEFAULT 0,
            sales_count INTEGER DEFAULT 0,
            reg_date TEXT
        );
        CREATE TABLE IF NOT EXISTS items (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            seller_id INTEGER,
            seller_name TEXT,
            title TEXT,
            description TEXT,
            price INTEGER,
            category TEXT,
            status TEXT DEFAULT 'pending',
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS item_videos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            item_id INTEGER,
            file_id TEXT,
            order_num INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS reviews (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            item_id INTEGER,
            seller_id INTEGER,
            buyer_id INTEGER,
            buyer_name TEXT,
            rating INTEGER,
            text TEXT,
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS purchases (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            item_id INTEGER,
            buyer_id INTEGER,
            buyer_name TEXT,
            seller_id INTEGER,
            status TEXT DEFAULT 'pending',
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS admins (
            user_id INTEGER PRIMARY KEY,
            role TEXT DEFAULT 'moderator',
            added_by INTEGER,
            added_at TEXT
        );
        CREATE TABLE IF NOT EXISTS bans (
            user_id INTEGER PRIMARY KEY,
            reason TEXT,
            banned_by INTEGER,
            banned_at TEXT
        );
    ''')
    conn.commit()
    conn.close()

def get_db():
    return sqlite3.connect('market.db', check_same_thread=False)

def get_or_create_user(uid, uname):
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT 1 FROM users WHERE user_id=?", (uid,))
    if not c.fetchone():
        c.execute("INSERT INTO users (user_id, username, reg_date) VALUES (?,?,?)",
                  (uid, uname, datetime.now().strftime("%Y-%m-%d %H:%M")))
        conn.commit()
    conn.close()

def is_admin(uid):
    if uid in ADMINS:
        return True
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT 1 FROM admins WHERE user_id=?", (uid,))
    res = c.fetchone()
    conn.close()
    return res is not None

def is_banned(uid):
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT 1 FROM bans WHERE user_id=?", (uid,))
    res = c.fetchone()
    conn.close()
    return res is not None

# ==================== MIDDLEWARE (БАН) ====================

class BanMiddleware(BaseMiddleware):
    def __init__(self):
        self.update_types = ['message', 'callback_query']
    
    def pre_process(self, update, data):
        if hasattr(update, 'from_user'):
            uid = update.from_user.id
        elif hasattr(update, 'message') and update.message:
            uid = update.message.from_user.id
        else:
            return
        if is_banned(uid):
            return CancelUpdate()

    def post_process(self, update, data, exception=None):
        pass

bot.setup_middleware(BanMiddleware())

# ==================== HELPERS ====================

def get_rating(uid):
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT AVG(rating), COUNT(*) FROM reviews WHERE seller_id=?", (uid,))
    avg, cnt = c.fetchone()
    conn.close()
    if avg is None: avg = 0
    return round(avg, 1), cnt

def get_reviews_text(item_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT buyer_name, rating, text, created_at FROM reviews WHERE item_id=? ORDER BY id DESC LIMIT 5", (item_id,))
    rows = c.fetchall()
    conn.close()
    if not rows: return "Отзывов пока нет."
    txt = ""
    for r in rows:
        stars = "⭐" * r[1]
        txt += f"{stars} <b>{r[0]}</b> ({r[3]})\n{r[2]}\n\n"
    return txt.strip()

def get_videos(item_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT file_id FROM item_videos WHERE item_id=? ORDER BY id", (item_id,))
    rows = [r[0] for r in c.fetchall()]
    conn.close()
    return rows

def clear_item_messages(uid, chat_id):
    if uid in user_item_msg:
        try: bot.delete_message(chat_id, user_item_msg[uid])
        except Exception as e: logger.error(f"Delete item msg error: {e}")
        del user_item_msg[uid]
    if uid in user_video_msgs:
        for mid in user_video_msgs[uid]:
            try: bot.delete_message(chat_id, mid)
            except Exception as e: logger.error(f"Delete video msg error: {e}")
        del user_video_msgs[uid]

def safe_edit_or_send(chat_id, current_msg_id, uid, text, reply_markup, parse_mode='HTML'):
    if uid in user_item_msg:
        clear_item_messages(uid, chat_id)
        return bot.send_message(chat_id, text, reply_markup=reply_markup, parse_mode=parse_mode)
    else:
        return bot.edit_message_text(text, chat_id, current_msg_id, reply_markup=reply_markup, parse_mode=parse_mode)

