def db_query(sql, params=(), fetch=None):
    with _db_lock:
        con = sqlite3.connect(DB_PATH)
        cur = con.cursor()
        cur.execute(sql, params)
        if fetch == "one":
            result = cur.fetchone()
        elif fetch == "all":
            result = cur.fetchall()
        elif fetch == "rows":
            result = cur.rowcount
        else:
            result = None
        con.commit()
        con.close()
    return result


def init_db():
    db_query("""
        CREATE TABLE IF NOT EXISTS users (
            user_id     INTEGER PRIMARY KEY,
            username    TEXT DEFAULT '',
            balance     INTEGER DEFAULT 0,
            wins        INTEGER DEFAULT 0,
            losses      INTEGER DEFAULT 0,
            games       INTEGER DEFAULT 0,
            earned      INTEGER DEFAULT 0,
            last_daily  REAL DEFAULT 0,
            loss_streak INTEGER DEFAULT 0,
            best_streak INTEGER DEFAULT 0,
            xp          INTEGER DEFAULT 0,
            daily_streak INTEGER DEFAULT 0,
            last_rescue REAL DEFAULT 0
        )
    """)
    # миграция для старой базы (порядок важен — колонки добавляются в конец)
    for col in ("loss_streak INTEGER DEFAULT 0", "best_streak INTEGER DEFAULT 0",
                "xp INTEGER DEFAULT 0", "daily_streak INTEGER DEFAULT 0",
                "last_rescue REAL DEFAULT 0"):
        try:
            db_query("ALTER TABLE users ADD COLUMN " + col)
        except sqlite3.OperationalError:
            pass
    db_query("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value INTEGER)")
    db_query("INSERT OR IGNORE INTO meta (key, value) VALUES ('jackpot', ?)", (JACKPOT_START,))


def get_user(uid):
    row = db_query("SELECT * FROM users WHERE user_id=?", (uid,), "one")
    if row is None:
        db_query("INSERT INTO users (user_id, balance) VALUES (?, ?)", (uid, START_BALANCE))
        row = db_query("SELECT * FROM users WHERE user_id=?", (uid,), "one")
    return row


def touch_username(uid, username):
