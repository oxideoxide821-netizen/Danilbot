def handle_attach_media(message):
    user_id = message.from_user.id
    if message.photo:
        file_id = message.photo[-1].file_id
        media_type = 'photo'
    elif message.video:
        file_id = message.video.file_id
        media_type = 'video'
    elif message.document:
        file_id = message.document.file_id
        media_type = 'document'
    else:
        bot.send_message(message.chat.id, "❌ Неподдерживаемый тип файла.")
        return
    db_query("UPDATE users SET media_file_id=?, media_type=? WHERE user_id=?", (file_id, media_type, user_id))
    user_states.pop(user_id, None)
    bot.send_message(message.chat.id, f"✅ Медиа прикреплено: {media_type}", reply_markup=main_menu_keyboard(has_accounts(user_id)))

