@bot.message_handler(func=lambda m: m.text and m.text.lower().startswith(("передать", "дать")))
def msg_transfer(message):
    text = message.text.lower().strip()
    parts = text.split()

    # Проверяем reply
    target_id = None
    target_username = None

    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
        target_username = message.reply_to_message.from_user.username or ""
        # Формат: "передать [кол-во] [тип]" (без @username, т.к. reply)
        if len(parts) < 3:
            bot.send_message(message.chat.id, "❌ Формат (reply): передать/дать [кол-во] [тип]", reply_markup=main_menu(message.from_user.id))
            return
        try:
            amount = int(parts[1])
        except:
            bot.send_message(message.chat.id, "❌ Укажи число", reply_markup=main_menu(message.from_user.id))
            return
        item_type = parts[2]
    else:
        # Обычный формат: передать [кол-во] [тип] @username
        if len(parts) < 4:
            bot.send_message(message.chat.id, "❌ Формат: передать/дать [кол-во] [тип] @username\nИли ответь (reply) на сообщение и напиши: передать/дать [кол-во] [тип]", reply_markup=main_menu(message.from_user.id))
            return
        try:
            amount = int(parts[1])
        except:
            bot.send_message(message.chat.id, "❌ Укажи число первым аргументом", reply_markup=main_menu(message.from_user.id))
            return
        item_type = parts[2]
        target_username = parts[3].replace("@", "")

    if amount <= 0:
        bot.send_message(message.chat.id, "❌ Количество должно быть больше 0", reply_markup=main_menu(message.from_user.id))
        return

    # Расширенный словарь с окончаниями
    item_map = {
        # Обычная трава
        "трава": "grass", "травы": "grass", "траву": "grass", "траве": "grass", "травой": "grass",
        "трав": "grass", "травка": "grass", "травки": "grass", "травку": "grass",
        "обычная": "grass", "обычной": "grass", "обычную": "grass", "обычные": "grass",
        "grass": "grass",
        # Редкая трава
        "редкая": "rare_grass", "редкой": "rare_grass", "редкую": "rare_grass", "редкие": "rare_grass",
        "редких": "rare_grass", "редким": "rare_grass", "редкая трава": "rare_grass",
        "редкой травы": "rare_grass", "редкую траву": "rare_grass",
        "rare": "rare_grass",
        # Легендарная трава
        "легендарная": "legendary_grass", "легендарной": "legendary_grass", "легендарную": "legendary_grass",
        "легендарные": "legendary_grass", "легендарных": "legendary_grass", "легендарным": "legendary_grass",
        "легендарная трава": "legendary_grass", "легендарной травы": "legendary_grass",
        "легендарную траву": "legendary_grass", "легенд": "legendary_grass",
        "legendary": "legendary_grass", "лега": "legendary_grass",
        # Косяки
        "косяк": "joints", "косяки": "joints", "косяка": "joints", "косяков": "joints",
        "косяку": "joints", "косяком": "joints",
        # Бланты
        "блант": "blunts", "бланты": "blunts", "бланта": "blunts", "блантов": "blunts",
        "бланту": "blunts", "блантом": "blunts",
        # Золотые косяки
        "золотой": "golden_joints", "золотые": "golden_joints", "голд": "golden_joints",
        "золотого": "golden_joints", "золотых": "golden_joints", "золотому": "golden_joints",
        "золотой косяк": "golden_joints", "золотые косяки": "golden_joints",
        "золотого косяка": "golden_joints", "золотых косяков": "golden_joints"
    }
    field = item_map.get(item_type, item_type)

    idx_map = {"grass": 3, "rare_grass": 4, "legendary_grass": 5, "joints": 6, "blunts": 7, "golden_joints": 8}
    idx = idx_map.get(field)
    if idx is None:
        bot.send_message(message.chat.id, "❌ Неизвестный тип предмета", reply_markup=main_menu(message.from_user.id))
        return

    user = get_user(message.from_user.id, message.from_user.username or "")
    if user[idx] < amount:
        item_name = ITEM_NAMES.get(field, field)
        bot.send_message(message.chat.id, f"❌ Недостаточно! У тебя: {user[idx]} {item_name}", reply_markup=main_menu(message.from_user.id))
        return

    # Определяем target_id
    if target_id is None:
        with db_lock:
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute("SELECT user_id FROM users WHERE username = ?", (target_username,))
            row = c.fetchone()
            conn.close()
        if not row:
            bot.send_message(message.chat.id, f"❌ Пользователь @{target_username} не найден в боте", reply_markup=main_menu(message.from_user.id))
            return
        target_id = row[0]

    if target_id == message.from_user.id:
        bot.send_message(message.chat.id, "❌ Нельзя передать самому себе", reply_markup=main_menu(message.from_user.id))
        return

    # Защита: нельзя передать боту
    bot_id = get_bot_id()
    if bot_id and target_id == bot_id:
        bot.send_message(message.chat.id, "❌ Нельзя передавать предметы боту!", reply_markup=main_menu(message.from_user.id))
        return

    # Защита от переполнения у получателя
    target_user = get_user(target_id)
    target_current = target_user[idx]
    if target_current + amount > MAX_SAFE_INT:
        bot.send_message(message.chat.id, "❌ У получателя слишком много предметов этого типа!", reply_markup=main_menu(message.from_user.id))
        return

    add_field(message.from_user.id, field, -amount)
    add_field(target_id, field, amount)

    item_name = ITEM_NAMES.get(field, field)

    # Формируем имя получателя красиво
    if target_username:
        display_name = f"@{target_username}"
    else:
        display_name = f"пользователю (ID: {target_id})"

    bot.send_message(
        message.chat.id,
        f"✅ Передано {amount} {item_name} {display_name}!",
        reply_markup=main_menu(message.from_user.id)
    )
    try:
        bot.send_message(target_id, f"📦 Тебе передали {amount} {item_name} от @{message.from_user.username or 'Безымянный'}!")
    except:
        pass

