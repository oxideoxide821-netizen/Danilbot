    return db_query("SELECT * FROM accounts WHERE id=?", (account_id,), fetchone=True)

def get_active_account(user_id):
    user = get_user(user_id)
    aid = user[7] if len(user) > 7 else None
    if not aid:
        return None
    return get_account(aid)

def set_active_account(user_id, account_id):
    db_query("UPDATE users SET active_account_id=? WHERE user_id=?", (account_id, user_id))

def delete_account(account_id):
    acc = get_account(account_id)
    if not acc:
        return
    user_id = acc[1]
    manager.disconnect(account_id)
    db_query("DELETE FROM selected_chats WHERE account_id=?", (account_id,))
    db_query("DELETE FROM accounts WHERE id=?", (account_id,))
    remaining = get_accounts(user_id)
    if remaining:
        set_active_account(user_id, remaining[0][0])
    else:
        db_query("UPDATE users SET active_account_id=NULL WHERE user_id=?", (user_id,))

def has_accounts(user_id):
    c = db_query("SELECT COUNT(*) FROM accounts WHERE user_id=?", (user_id,), fetchone=True)
    return c and c[0] > 0

def get_selected_chats(user_id, account_id):
    return db_query("SELECT chat_id, chat_name FROM selected_chats WHERE user_id=? AND account_id=?", (user_id, account_id))

def toggle_chat_selection(user_id, account_id, chat_id, chat_name):
    existing = db_query("SELECT 1 FROM selected_chats WHERE user_id=? AND account_id=? AND chat_id=?", (user_id, account_id, chat_id), fetchone=True)
    if existing:
        db_query("DELETE FROM selected_chats WHERE user_id=? AND account_id=? AND chat_id=?", (user_id, account_id, chat_id))
        return False
    else:
        db_query("INSERT OR REPLACE INTO selected_chats (user_id, account_id, chat_id, chat_name) VALUES (?,?,?,?)", (user_id, account_id, chat_id, chat_name))
        return True

def clear_selected_chats(user_id, account_id):
    db_query("DELETE FROM selected_chats WHERE user_id=? AND account_id=?", (user_id, account_id))

