ROOT = Path(__file__).resolve().parent
CONFIG_FILE = ROOT / "tg_config.json"
SESSION_DIR = ROOT / "sessions"
SESSION_DIR.mkdir(exist_ok=True)
app = FastAPI(title="Telegram Desk")
accounts = {}
pending = {}
api_id = None
api_hash = None
queue_state = {"task": None, "paused": False, "stop": False, "remaining": 0, "pending": 0,
               "sent": 0, "total": 0, "account": None, "peer": None,
               "chat_name": "", "last_error": "", "caps": False, "randomized": True}
DOWNLOAD_DIR = ROOT / "downloads"
DOWNLOAD_DIR.mkdir(exist_ok=True)

class QueueRequest(BaseModel):
    text: str
    words_per_message: int = 1
    delay: float = 0.3
    random_max: int = 5
    reply_to: Optional[int] = None

def load_config():
    global api_id, api_hash
    if CONFIG_FILE.exists():
        try:
            c = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            api_id, api_hash = int(c["api_id"]), c["api_hash"]
        except Exception:
            pass

def save_config(i, h):
    global api_id, api_hash
    api_id, api_hash = int(i), h.strip()
    CONFIG_FILE.write_text(json.dumps({"api_id": api_id, "api_hash": api_hash}), encoding="utf-8")

def require_config():
    if not api_id or not api_hash:
        raise HTTPException(400, "Сначала сохраните API ID и API Hash в настройках.")

def acc_or_404(i):
    if i not in accounts:
        raise HTTPException(404, "Аккаунт не найден.")
    return accounts[i]

def name_of(me):
    return (f"@{me.username}" if me.username else " ".join(x for x in [me.first_name, me.last_name] if x)) or "Telegram"

class Config(BaseModel):
    api_id: int
    api_hash: str
class Phone(BaseModel):
    phone: str
class Code(BaseModel):
    phone: str
    code: str
class Password(BaseModel):
    password: str
class Message(BaseModel):
    text: str
    reply_to: Optional[int] = None

@app.on_event("startup")
async def startup():
    load_config()
    if not api_id or not api_hash:
        return
    import shutil
    for i in range(15):
        old = ROOT / f"console_acc_{i}.session"
        session = SESSION_DIR / f"acc_{i}.session"
        if old.exists() and not session.exists():
            shutil.copy2(old, session)
        if session.exists():
            try:
                client = TelegramClient(str(SESSION_DIR / f"acc_{i}"), api_id, api_hash)
                await client.connect()
                if await client.is_user_authorized():
                    me = await client.get_me()
                    accounts[i] = {"client": client, "name": name_of(me)}
                else:
                    await client.disconnect()
            except Exception as e:
                print(f"Не удалось загрузить аккаунт {i}: {e}")

