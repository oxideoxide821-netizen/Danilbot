<div class="composer"><textarea id="msg" placeholder="Сообщение…" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();send()}"></textarea><button class="primary" onclick="send()">➤</button><input id="filePicker" type="file" accept=".txt,.md,text/plain" style="display:none" onchange="readTextFile(this)"></div></main></div>
