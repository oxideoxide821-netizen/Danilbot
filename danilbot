@bot.callback_query_handler(func=lambda c: c.data.startswith('rev_'))
def cb_rev_start(c):
    bot.answer_callback_query(c.id)
    uid = c.from_user.id
    item_id = int(c.data.split('_')[1])
    
    conn = get_db()
    cur = conn.cursor()
    
    # Нельзя себе
    cur.execute("SELECT seller_id FROM items WHERE id=?", (item_id,))
    row = cur.fetchone()
    if row and row[0] == uid:
        conn.close()
        bot.answer_callback_query(c.id, "❌ Нельзя оставить отзыв самому себе!", show_alert=True)
        return
    
    # Уже оставлял?
    cur.execute("SELECT 1 FROM reviews WHERE item_id=? AND buyer_id=?", (item_id, uid))
    if cur.fetchone():
        conn.close()
        bot.answer_callback_query(c.id, "❌ Ты уже оставлял отзыв на этот товар!", show_alert=True)
        return
    
    # Покупал ли?
    cur.execute("SELECT 1 FROM purchases WHERE item_id=? AND buyer_id=? AND status='confirmed'", (item_id, uid))
    if not cur.fetchone():
        conn.close()
        bot.answer_callback_query(c.id, "❌ Ты не покупал этот товар! Нажми «Купить» и дождись подтверждения продавца.", show_alert=True)
        return
    
    conn.close()
    clear_item_messages(uid, c.message.chat.id)
    user_data[uid] = {'rev_item': item_id}
    bot.send_message(c.message.chat.id, "⭐ Выбери оценку:", reply_markup=kb_rate(item_id))

