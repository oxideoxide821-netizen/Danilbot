def fmt(n):
    return "{:,}".format(int(n)).replace(",", " ")


def parse_amount(text):
    """Понимает 100, 5к, 2.5к. Возвращает int или None."""
    if not text:
        return None
    text = text.lower().replace(" ", "")
    mult = 1
    if text.endswith("к"):
        mult = 1000
        text = text[:-1]
    try:
        return int(float(text) * mult)
    except ValueError:
        return None


