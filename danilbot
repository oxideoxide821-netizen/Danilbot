@bot.message_handler(func=lambda m: user_states.get(m.from_user.id) == 'set_interval')
def handle_set_interval(message):
    user_id = message.from_user.id
    try:
        interval = float(message.text.replace(',', '.'))
        if interval < 0.5:
            interval = 0.5
        db_query("UPDATE users SET broadcast_interval=? WHERE user_id=?", (interval, user_id))
        user_states.pop(user_id, None)
        bot.send_message(message.chat.id, f"✅ Интервал установлен: {interval} сек", reply_markup=main_menu_keyboard(has_accounts(user_id)))
    except ValueError:
        bot.send_message(message.chat.id, "❌ Введите число, например 1.5 или 2")

