def sell_item(user_id, username, chat_id, item, amount_str, message_id=None):
    user = get_user(user_id, username)
    fields = {"grass": ("grass", 3, PRICES["grass"]),
              "rare": ("rare_grass", 4, PRICES["rare_grass"]),
              "legendary": ("legendary_grass", 5, PRICES["legendary_grass"])}

    if item not in fields:
        return

    field, idx, price = fields[item]
    have = user[idx]
    item_name = ITEM_NAMES.get(field, field)

    if amount_str.lower() in ["все", "all"]:
        amount = have
    else:
        try:
            amount = int(amount_str)
        except:
            text = "❌ Укажи число или слово 'все'"
            if message_id:
                safe_edit(chat_id, message_id, text, sell_menu(user_id))
            else:
                bot.send_message(chat_id, text, reply_markup=sell_menu(user_id))
            return

    if amount <= 0:
        text = "❌ Количество должно быть больше 0"
    elif have < amount:
        text = f"❌ Недостаточно товара! У тебя: {have} {item_name}"
    else:
        earnings = amount * price
        if earnings > MAX_SAFE_INT:
            earnings = MAX_SAFE_INT
        add_field(user_id, field, -amount)
        add_field(user_id, "balance", earnings)
        text = f"💰 Продано {amount} {item_name} за {earnings:,} монет!"

    if message_id:
        safe_edit(chat_id, message_id, text, sell_menu(user_id))
    else:
        bot.send_message(chat_id, text, reply_markup=sell_menu(user_id))

def buy_item(user_id, username, chat_id, item, amount_str, message_id=None):
    user = get_user(user_id, username)
    fields = {"grass": ("grass", PRICES["grass"]),
              "rare": ("rare_grass", PRICES["rare_grass"]),
              "legendary": ("legendary_grass", PRICES["legendary_grass"])}

    if item not in fields:
        return

    field, price = fields[item]
    item_name = ITEM_NAMES.get(field, field)

    if amount_str.lower() in ["все", "all"]:
        balance = user[2]
        amount = balance // price
    else:
        try:
            amount = int(amount_str)
        except:
            text = "❌ Укажи число или слово 'все'"
            if message_id:
                safe_edit(chat_id, message_id, text, buy_menu(user_id))
            else:
                bot.send_message(chat_id, text, reply_markup=buy_menu(user_id))
            return

    cost = amount * price
    if cost > MAX_SAFE_INT:
        cost = MAX_SAFE_INT

    if amount <= 0:
        text = "❌ Количество должно быть больше 0"
    elif user[2] < cost:
        text = f"❌ Недостаточно монет! Нужно: {cost:,}, есть: {user[2]:,}"
    else:
        add_field(user_id, "balance", -cost)
        add_field(user_id, field, amount)
        text = f"🛒 Куплено {amount} {item_name} за {cost:,} монет!"

    if message_id:
        safe_edit(chat_id, message_id, text, buy_menu(user_id))
    else:
        bot.send_message(chat_id, text, reply_markup=buy_menu(user_id))

