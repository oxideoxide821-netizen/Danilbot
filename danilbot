@bot.message_handler(func=lambda m: m.from_user.id in qr_manager.pending)
def handle_2fa_input(message):
    user_id = message.from_user.id
    pending = qr_manager.pending.get(user_id)
    if not pending:
        bot.send_message(user_id, "❌ Нет активной авторизации.", reply_markup=main_menu_keyboard(has_accounts(user_id)))
        return
    text = message.text.strip()
    if pending.get('needs_email') and pending.get('email_value') is None:
        if qr_manager.submit_email(user_id, text):
            bot.send_message(user_id, "⏳ Проверка email-кода...")
        else:
            bot.send_message(user_id, "❌ Ошибка обработки email-кода.")
    elif pending.get('password_value') is None:
        if qr_manager.submit_password(user_id, text):
            bot.send_message(user_id, "⏳ Проверка пароля...")
        else:
            bot.send_message(user_id, "❌ Ошибка обработки пароля.")
    else:
        bot.send_message(user_id, "⏳ Проверяется предыдущий код, подождите...")

