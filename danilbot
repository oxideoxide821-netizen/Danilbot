def ensure_user(user_id, username=None, first_name=None):
    row = db_query("SELECT 1 FROM users WHERE user_id=?", (user_id,), fetchone=True)
    if not row:
        db_query("INSERT INTO users (user_id, username, first_name) VALUES (?,?,?)", 
                 (user_id, username, first_name))

def is_admin(user_id):
    return user_id in ADMIN_IDS

def get_available_accounts():
    return db_query("SELECT id, phone, price, country_code FROM accounts WHERE status='available' ORDER BY id DESC")

def mask_phone(phone):
    if len(phone) >= 10:
        return phone[:3] + " ••• " + phone[-3:]
    return phone

