# ================== DATABASE ==================
def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    
    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    c.execute("""
        CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            phone TEXT UNIQUE,
            session_string TEXT,
            price REAL,
            country_code TEXT DEFAULT 'other',
            status TEXT DEFAULT 'available',
            buyer_id INTEGER DEFAULT NULL,
            added_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    c.execute("""
        CREATE TABLE IF NOT EXISTS orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            buyer_id INTEGER,
            account_id INTEGER,
            status TEXT DEFAULT 'pending',
            receipt_file_id TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    conn.commit()
    conn.close()

def db_query(query, params=(), fetchone=False):
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute(query, params)
    conn.commit()
    result = c.fetchone() if fetchone else c.fetchall()
    conn.close()
    return result

# ================== TELETHON MANAGER (для проданных аккаунтов — перехват кода) ==================
class TelethonManager:
    def __init__(self):
        self.clients = {}
        self.loops = {}
        self.threads = {}

    def start_account(self, phone, session_string):
        key = f"acc_{phone}"
        if key in self.threads and self.threads[key].is_alive():
            return True
        t = threading.Thread(target=self._account_loop, args=(phone, session_string), daemon=True)
        t.start()
        self.threads[key] = t
        for _ in range(100):
            if key in self.clients:
                return True
            time.sleep(0.1)
        return False

    def _account_loop(self, phone, session_string):
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        client = TelegramClient(StringSession(session_string), API_ID, API_HASH, loop=loop)
        
        @client.on(events.NewMessage)
        async def code_handler(event):
            try:
                sender = await event.get_sender()
                if not sender or sender.id != 777000:
                    return
                text = event.message.text or ""
                if not any(k in text.lower() for k in ['код', 'code', 'login', 'вход']):
                    return
                match = re.search(r'\b\d{5}\b', text)
                if not match:
                    return
                code = match.group()
                
                account = db_query(
                    "SELECT * FROM accounts WHERE phone=? AND status='sold' ORDER BY id DESC LIMIT 1",
                    (phone,), fetchone=True
                )
                if not account:
                    return
                order = db_query(
                    "SELECT * FROM orders WHERE account_id=? AND status='confirmed' ORDER BY id DESC LIMIT 1",
                    (account[0],), fetchone=True
                )
                if not order:
                    return
                buyer_id = order[1]
                country_name = COUNTRIES.get(account[4], "🌍 Другая")
                bot.send_message(
                    buyer_id,
                    f"🔐 <b>Код подтверждения получен!</b>\n\n"
                    f"📱 Аккаунт: <code>{phone}</code>\n"
                    f"🌍 Страна: {country_name}\n"
                    f"🔑 Код: <code>{code}</code>\n\n"
                    f"Введите этот код в Telegram для завершения входа.",
                    parse_mode='HTML'
                )
            except Exception as e:
                print(f"[CODE HANDLER ERROR] {e}")

        async def init():
            await client.connect()
            if not await client.is_user_authorized():
                print(f"[AUTH ERROR] Account {phone} not authorized")
                return False
            self.clients[f"acc_{phone}"] = client
            self.loops[f"acc_{phone}"] = loop
            return True
        
        if loop.run_until_complete(init()):
            loop.run_forever()

    def disconnect_account(self, phone):
        key = f"acc_{phone}"
        if key in self.clients:
            try:
                self.clients[key].disconnect()
            except:
                pass
            del self.clients[key]
        if key in self.loops:
            try:
                self.loops[key].stop()
            except:
                pass
            del self.loops[key]

