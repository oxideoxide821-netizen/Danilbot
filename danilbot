# ============================ БАЗА ДАННЫХ ============================

_db_lock = threading.Lock()


def db_query(sql, params=(), fetch=None):
    with _db_lock:
        con = sqlite3.connect(DB_PATH)
        cur = con.cursor()
        cur.execute(sql, params)
        if fetch == "one":
            result = cur.fetchone()
        elif fetch == "all":
            result = cur.fetchall()
        else:
            result = None
        con.commit()
        con.close()
    return result


def init_db():
    db_query("""
        CREATE TABLE IF NOT EXISTS users (
            user_id     INTEGER PRIMARY KEY,
            username    TEXT DEFAULT '',
            balance     INTEGER DEFAULT 0,
            wins        INTEGER DEFAULT 0,
            losses      INTEGER DEFAULT 0,
            games       INTEGER DEFAULT 0,
            earned      INTEGER DEFAULT 0,
            last_daily  REAL DEFAULT 0
        )
    """)


def get_user(uid):
    row = db_query("SELECT * FROM users WHERE user_id=?", (uid,), "one")
    if row is None:
        db_query("INSERT INTO users (user_id, balance) VALUES (?, ?)", (uid, START_BALANCE))
        row = db_query("SELECT * FROM users WHERE user_id=?", (uid,), "one")
    return row


def touch_username(uid, username):
    if username:
        db_query("UPDATE users SET username=? WHERE user_id=?", (username.lower(), uid))


def add_balance(uid, delta):
    db_query("UPDATE users SET balance = balance + ? WHERE user_id=?", (delta, uid))


def add_stats(uid, won, profit):
    if won:
        db_query("UPDATE users SET wins=wins+1, games=games+1, earned=earned+? WHERE user_id=?",
                 (profit, uid))
    else:
        db_query("UPDATE users SET losses=losses+1, games=games+1 WHERE user_id=?", (uid,))


# ============================ ЗАЩИТА ОТ СПАМА ============================

_last_cmd = {}   # uid -> время последней команды
_flood_log = {}  # uid -> список меток времени
_blocked = {}    # uid -> время разблокировки


def is_spam(uid):
    """Возвращает текст предупреждения или None, если команда разрешена."""
    now = time.time()
    if _blocked.get(uid, 0) > now:
        return "Слишком много запросов. Повторите через {} с.".format(int(_blocked[uid] - now) + 1)
    log = _flood_log.setdefault(uid, [])
    log.append(now)
    log[:] = [t for t in log if now - t < FLOOD_WINDOW]
    if len(log) > FLOOD_LIMIT:
        _blocked[uid] = now + FLOOD_BLOCK
        _flood_log.pop(uid, None)
        return "Обнаружен флуд. Команды заблокированы на {} с.".format(FLOOD_BLOCK)
    if now - _last_cmd.get(uid, 0) < CMD_COOLDOWN:
        return "Не так быстро. Подождите немного."
    _last_cmd[uid] = now
    return None


