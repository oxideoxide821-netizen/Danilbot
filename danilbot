def show_chat_selection(chat_id, message_id, user_id, page=0):
    try:
        manager.start_client(user_id, get_user(user_id)[1])
        client = manager.get_client(user_id)
        if not client:
            try:
                bot.edit_message_text(
                    "❌ <b>Не удалось подключиться к аккаунту</b>\n\nПопробуйте выйти и авторизоваться заново.",
                    chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("main_menu")
                )
            except:
                pass
            return
        me = manager.run_sync(user_id, client.get_me(), timeout=30)
        dialogs = manager.run_sync(user_id, fetch_all_group_dialogs(client, me.id), timeout=600)
        if not dialogs:
            bot.edit_message_text(
                "📋 <b>Чаты для рассылки</b>\n\nУ вас нет доступных групп.",
                chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("main_menu")
            )
            return

        selected = {row[0] for row in get_selected_chats(user_id)}
        per_page = 10
        start = page * per_page
        end = start + per_page
        page_dialogs = dialogs[start:end]

        kb = InlineKeyboardMarkup(row_width=1)
        for d in page_dialogs:
            cid = d.id
            name = d.name or "Без названия"
            is_selected = cid in selected
            icon = "☑️" if is_selected else "⬜️"
            safe_name = name.replace(":", " ")[:25]
            kb.add(InlineKeyboardButton(f"{icon} {safe_name}", callback_data=f"tc:{cid}:{page}"))

        nav_buttons = []
        if page > 0:
            nav_buttons.append(InlineKeyboardButton("◀️ Назад", callback_data=f"chat_page:{page-1}"))
        if end < len(dialogs):
            nav_buttons.append(InlineKeyboardButton("Вперед ▶️", callback_data=f"chat_page:{page+1}"))
        if nav_buttons:
            kb.row(*nav_buttons)

