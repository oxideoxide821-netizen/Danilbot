# ---------- Слоты: множители считаются из вероятности символа ----------
REEL = ["7", "$", "%", "&", "*", "X"]
REEL_WEIGHTS = [1, 2, 3, 4, 5, 6]
SLOT_TRIPLE_SHARE = 0.70      # доля RTP, приходящаяся на тройки
SLOT_PAIR_MULT = 0.5          # любая пара возвращает половину ставки
SLOT_MAX_MULT = 500

_W = sum(REEL_WEIGHTS)
SLOT_PAYTABLE = {}
for _s, _w in zip(REEL, REEL_WEIGHTS):
    _p = (_w / _W) ** 3
    SLOT_PAYTABLE[_s] = max(2, min(SLOT_MAX_MULT, round(SLOT_TRIPLE_SHARE / len(REEL) / _p)))

# ---------- Колесо удачи: чем больше множитель, тем реже сектор ----------
WHEEL_MULTS = [0.5, 1.5, 3, 6, 15, 50, 200]
WHEEL_SECTORS = []            # (множитель, вероятность)
_share = 0.95 / len(WHEEL_MULTS)
for _m in WHEEL_MULTS:
    WHEEL_SECTORS.append((_m, _share / _m))
WHEEL_SECTORS.insert(0, (0, 1 - sum(p for _, p in WHEEL_SECTORS)))

