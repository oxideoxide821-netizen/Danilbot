# ==================== CALLBACK HELPERS (owner_id защита) ====================
def cb(action, owner_id):
    """Формирует callback_data с owner_id для защиты кнопок"""
    return f"{action}_{owner_id}"

def parse_cb(data):
    """Парсит callback_data: возвращает (action, owner_id или None)"""
    parts = data.rsplit("_", 1)
    if len(parts) == 2 and parts[1].lstrip("-").isdigit():
        return parts[0], int(parts[1])
    return data, None

# ==================== БАЗА ДАННЫХ ====================
db_lock = threading.Lock()

def init_db():
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT DEFAULT '',
                balance INTEGER DEFAULT 0,
                grass INTEGER DEFAULT 0,
                rare_grass INTEGER DEFAULT 0,
                legendary_grass INTEGER DEFAULT 0,
                joints INTEGER DEFAULT 0,
                blunts INTEGER DEFAULT 0,
                golden_joints INTEGER DEFAULT 0,
                total_smoked INTEGER DEFAULT 0,
                total_high INTEGER DEFAULT 0,
                level INTEGER DEFAULT 1,
                exp INTEGER DEFAULT 0,
                farm_power INTEGER DEFAULT 1,
                legendary_chance INTEGER DEFAULT 0,
                last_farm INTEGER DEFAULT 0,
                last_daily INTEGER DEFAULT 0,
                lopata INTEGER DEFAULT 0,
                seeds INTEGER DEFAULT 0,
                greenhouse INTEGER DEFAULT 0
            )
        """)
        conn.commit()
        conn.close()

def get_user(user_id, username=""):
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
        user = c.fetchone()
        if not user:
            c.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (user_id, username))
            conn.commit()
            c.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
            user = c.fetchone()
        elif username and user[1] != username:
            c.execute("UPDATE users SET username = ? WHERE user_id = ?", (username, user_id))
            conn.commit()
        conn.close()
    return user

def update_user(user_id, field, value):
    if field not in VALID_FIELDS:
        return
    if isinstance(value, int):
        if value > MAX_SAFE_INT:
            value = MAX_SAFE_INT
        if value < 0:
            value = 0
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute(f"UPDATE users SET {field} = ? WHERE user_id = ?", (value, user_id))
        conn.commit()
        conn.close()

def add_field(user_id, field, amount):
    if field not in VALID_FIELDS:
        return 0
    user = get_user(user_id)
    idx = {
        "balance": 2, "grass": 3, "rare_grass": 4, "legendary_grass": 5,
        "joints": 6, "blunts": 7, "golden_joints": 8, "total_smoked": 9,
        "total_high": 10, "level": 11, "exp": 12, "farm_power": 13,
        "legendary_chance": 14, "lopata": 17, "seeds": 18, "greenhouse": 19
    }
    current = user[idx[field]] if field in idx else 0
    new_val = current + amount
    update_user(user_id, field, new_val)
    return new_val

