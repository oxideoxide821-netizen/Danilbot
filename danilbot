def play_slots(uid, chat_id, bet):
    reels = random.choices(REEL, weights=REEL_WEIGHTS, k=3)
    line = " | ".join(reels)
    head = "Слоты: [ {} ]".format(line)
    gross = 0
    if reels[0] == reels[1] == reels[2]:
        mult = SLOT_PAYTABLE[reels[0]]
        gross = bet * mult
        head += "\nТройка! Выплата х{}.".format(mult)
        if reels[0] == "7":
            jp = take_jackpot()
            gross += jp
            head += "\nДЖЕКПОТ! Дополнительно: +{}".format(fmt(jp))
    elif len(set(reels)) == 2:
        gross = int(bet * SLOT_PAIR_MULT)
        head += "\nПара — возвращается половина ставки."
    else:
        head += "\nКомбинации нет."
    finish(chat_id, uid, bet, gross, head, "slots")


def play_wheel(uid, chat_id, bet):
    r = random.random()
    acc = 0.0
    mult = 0
    for m, p in WHEEL_SECTORS:
        acc += p
        if r < acc:
            mult = m
            break
    gross = int(bet * mult)
    if mult == 0:
        head = "Колесо остановилось на х0. Мимо."
    elif mult < 1:
        head = "Колесо: х{}. Часть ставки вернулась.".format(fmt_mult(mult))
    else:
        head = "Колесо: х{}!".format(fmt_mult(mult))
    finish(chat_id, uid, bet, gross, head, "wheel")


def play_risk(uid, chat_id, bet, chance):
    mult = risk_mult(chance)
    roll = random.random() * 100
    if roll < chance:
        gross = int(bet * mult)
        head = "Шанс {}%, множитель х{}. Выпало {:.2f} — удача!".format(chance, fmt_mult(mult), roll)
    else:
        gross = 0
        head = "Шанс {}%, множитель х{}. Выпало {:.2f} — мимо.".format(chance, fmt_mult(mult), roll)
    finish(chat_id, uid, bet, gross, head, "risk")


