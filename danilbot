def show_chat_selection(chat_id, message_id, user_id, page=0, force_refresh=False):
    try:
        acc = get_active_account(user_id)
        if not acc:
            safe_edit_message_text("❌ <b>Нет активного аккаунта</b>\n\nВыберите или добавьте аккаунт в разделе 👤 Мои аккаунты.", chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("my_accounts"))
            return
        account_id = acc[0]
        session = acc[2]
        manager.start_client(account_id, session)
        client = manager.get_client(account_id)
        if not client:
            safe_edit_message_text("❌ <b>Не удалось подключиться к аккаунту</b>\n\nПопробуйте выбрать другой аккаунт.", chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("my_accounts"))
            return
        me = manager.run_sync(account_id, client.get_me(), timeout=30)
        dialogs = manager.get_dialogs_cached(account_id, client, me.id, force_refresh=force_refresh)
        filt = chat_filters.get(user_id, "").lower()
        if filt:
            dialogs = [d for d in dialogs if filt in (d.name or "").lower()]
        if not dialogs:
            text = "📋 <b>Чаты для рассылки</b>\n\nНет доступных групп"
            text += f" по фильтру «<code>{filt}</code>»." if filt else "."
            safe_edit_message_text(text, chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("main_menu"))
            return
        selected = {row[0] for row in get_selected_chats(user_id, account_id)}
        per_page = 10
        start = page * per_page
        end = start + per_page
        page_dialogs = dialogs[start:end]
        kb = InlineKeyboardMarkup(row_width=1)
        for d in page_dialogs:
            cid = d.id
            name = d.name or "Без названия"
            is_selected = cid in selected
            icon = "☑️" if is_selected else "⬜️"
            safe_name = name.replace(":", " ")[:25]
            kb.add(InlineKeyboardButton(f"{icon} {safe_name}", callback_data=f"tc:{cid}:{page}"))
        nav_buttons = []
        if page > 0:
            nav_buttons.append(InlineKeyboardButton("◀️ Назад", callback_data=f"chat_page:{page-1}"))
        if end < len(dialogs):
            nav_buttons.append(InlineKeyboardButton("Вперед ▶️", callback_data=f"chat_page:{page+1}"))
        if nav_buttons:
            kb.row(*nav_buttons)
        mode = get_user(user_id)[5] if len(get_user(user_id)) > 5 else 'all'
        mode_text = "📨 Во все чаты" if mode == 'all' else "📋 Выбранные чаты"
        kb.add(InlineKeyboardButton(f"🔄 Режим: {mode_text}", callback_data="toggle_send_mode"))
        kb.add(InlineKeyboardButton("🔍 Фильтр по названию", callback_data="chat_filter"))
        if filt:
            kb.add(InlineKeyboardButton("❌ Сбросить фильтр", callback_data="chat_filter_reset"))
        kb.add(InlineKeyboardButton("🔄 Обновить список", callback_data="refresh_chats"))
        kb.add(InlineKeyboardButton("✅ Готово", callback_data="main_menu"))
        text = (f"📋 <b>Чаты для рассылки</b>\n\n"
                f"Аккаунт: <code>{acc[4]} {acc[5]}</code>\n"
                f"Страница {page+1} из {(len(dialogs)-1)//per_page + 1}\n"
                f"📊 Всего групп: {len(dialogs)}\n"
                f"☑️ Выбрано: {len(selected)}")
        if filt:
            text += f"\n🔍 Фильтр: <code>{filt}</code>"
        text += "\n\nНажмите на чат, чтобы выбрать или убрать его из списка."
        safe_edit_message_text(text, chat_id=chat_id, message_id=message_id, reply_markup=kb)
    except Exception as e:
        try:
            safe_edit_message_text(f"❌ <b>Ошибка загрузки чатов</b>\n\n{str(e)[:200]}", chat_id=chat_id, message_id=message_id, reply_markup=back_keyboard("main_menu"))
        except:
            try:
                bot.send_message(chat_id, f"❌ <b>Ошибка загрузки чатов</b>\n\n{str(e)[:200]}", reply_markup=back_keyboard("main_menu"))
            except:
                pass

