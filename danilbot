@bot.callback_query_handler(func=lambda call: True)
def on_callback(call):
    uid = call.from_user.id
    chat_id = call.message.chat.id
    try:
        bot.answer_callback_query(call.id)
    except Exception:
        pass

    if _blocked.get(uid, 0) > time.time():
        return
    get_user(uid)
    expire_pending(uid)

    parts = call.data.split("|")
    tag = parts[0]

    if tag == "menu" and parts[1] == "games":
        cmd_games(call.message)

    elif tag == "game":
        begin_game(uid, chat_id, parts[1], None)

    elif tag == "bet":
        game, amount = parts[1], parts[2]
        if amount == "custom":
            if is_busy(uid) and pending.get(uid, {}).get("await") != "bet":
                bot.send_message(chat_id, "Сначала завершите текущую игру.")
                return
            pending[uid] = {"game": game, "await": "bet"}
            bot.send_message(chat_id, "Введите вашу ставку (или «отмена»):")
        else:
            begin_game(uid, chat_id, game, int(amount))

    elif tag == "again":
        begin_game(uid, chat_id, parts[1], int(parts[2]))

    elif tag == "side":
        if pending.get(uid, {}).get("game") == "coin":
            settle_coin(uid, chat_id, parts[1])

    elif tag == "dice":
        if pending.get(uid, {}).get("game") == "dice":
            state = pending.pop(uid)
            settle_dice(uid, chat_id, state["bet"], parts[1])

    elif tag == "roul":
        state = pending.get(uid)
        if not state or state.get("game") != "roulette":
            return
        if parts[1] == "num":
            state["await"] = "num"
            bot.send_message(chat_id, "Введите число от 0 до 36:")
        else:
            pending.pop(uid, None)
            spin_roulette(uid, chat_id, state["bet"], parts[1])

    elif tag == "gnum":
        if pending.get(uid, {}).get("game") == "guess":
            settle_guess(uid, chat_id, int(parts[1]))

    elif tag == "risk":
        state = pending.get(uid)
        if state and state.get("game") == "risk":
            pending.pop(uid, None)
            play_risk(uid, chat_id, state["bet"], int(parts[1]))

    elif tag == "bj":
        if parts[1] == "hit":
            bj_hit(uid)
        elif parts[1] == "dbl":
            bj_double(uid, chat_id)
        else:
            bj_stand(uid)

    elif tag == "cashout":
        crash_cashout(uid, chat_id)


