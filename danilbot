@bot.callback_query_handler(func=lambda c: c.data.startswith('buy_'))
def cb_buy(c):
    bot.answer_callback_query(c.id)
    uid = c.from_user.id
    item_id = int(c.data.split('_')[1])
    
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT seller_id, seller_name, title FROM items WHERE id=?", (item_id,))
    row = cur.fetchone()
    if not row:
        conn.close()
        bot.answer_callback_query(c.id, "❌ Товар не найден.", show_alert=True)
        return
    seller_id, seller_name, title = row
    
    if uid == seller_id:
        conn.close()
        bot.answer_callback_query(c.id, "❌ Это твой товар!", show_alert=True)
        return
    
    cur.execute("SELECT status FROM purchases WHERE item_id=? AND buyer_id=?", (item_id, uid))
    existing = cur.fetchone()
    if existing:
        conn.close()
        bot.answer_callback_query(c.id, f"❌ У тебя уже есть заявка (статус: {existing[0]}).", show_alert=True)
        return
    
    cur.execute("INSERT INTO purchases (item_id, buyer_id, buyer_name, seller_id, status, created_at) VALUES (?,?,?,?,?,?)",
                (item_id, uid, c.from_user.username or c.from_user.first_name, seller_id, 'pending',
                 datetime.now().strftime("%Y-%m-%d %H:%M")))
    purchase_id = cur.lastrowid
    conn.commit()
    conn.close()
    
    kb = InlineKeyboardMarkup()
    kb.row(InlineKeyboardButton("✅ Подтвердить", callback_data=f"confbuy_{purchase_id}"),
           InlineKeyboardButton("❌ Отклонить", callback_data=f"rejbuy_{purchase_id}"))
    try:
        bot.send_message(seller_id, f"🛒 <b>Новая заявка на покупку!</b>\n\n"
                         f"📦 Товар: <b>{title}</b>\n"
                         f"👤 Покупатель: @{c.from_user.username or c.from_user.first_name} (ID: <code>{uid}</code>)\n\n"
                         f"Подтверди или отклони:", reply_markup=kb, parse_mode='HTML')
    except Exception as e:
        logger.error(f"Notify seller failed: {e}")
    
    bot.answer_callback_query(c.id, "✅ Заявка отправлена продавцу! Жди подтверждения.", show_alert=True)

@bot.callback_query_handler(func=lambda c: c.data.startswith('confbuy_'))
def cb_confirm_buy(c):
    bot.answer_callback_query(c.id)
    purchase_id = int(c.data.split('_')[1])
    
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT item_id, buyer_id, seller_id, status FROM purchases WHERE id=?", (purchase_id,))
    row = cur.fetchone()
