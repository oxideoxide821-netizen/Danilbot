def play_slots(uid, chat_id, bet):
    reels = random.choices(REEL, weights=REEL_WEIGHTS, k=3)
    line = " | ".join(reels)
    mult = SLOT_PAYTABLE.get(tuple(reels))
    if mult:
        total = bet * mult
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(chat_id,
                    "Слоты: [ {} ]\nКомбинация — выплата х{}. Итог: +{}".format(line, mult, fmt(total)),
                    "slots", bet)
    else:
        add_stats(uid, False, 0)
        send_result(chat_id,
                    "Слоты: [ {} ]\nКомбинации нет. Итог: -{}".format(line, fmt(bet)),
                    "slots", bet)


def settle_coin(uid, chat_id, side):
    state = pending.pop(uid, None)
    if not state:
        return
    bet = state["bet"]
    result = random.choice(["орел", "решка"])
    if result == side:
        total = int(bet * 1.9)
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(chat_id, "Выпала {}. Ваша ставка сыграла: +{}".format(result, fmt(total)), "coin", bet)
    else:
        add_stats(uid, False, 0)
        send_result(chat_id, "Выпала {}. Ставка не сыграла: -{}".format(result, fmt(bet)), "coin", bet)


def settle_dice(uid, chat_id, bet, guess):
    msg = bot.send_dice(chat_id)
    value = msg.dice.value  # значение известно сразу, ждём конца анимации

    def finish():
        if guess in ("чет", "нечет"):
            ok = (value % 2 == 0) == (guess == "чет")
        else:
            ok = (value <= 3) == (guess == "мало")
        if ok:
            total = bet * 2
            add_balance(uid, total)
            add_stats(uid, True, total - bet)
            send_result(chat_id, "Выпало {}. Прогноз верен: +{}".format(value, fmt(total)), "dice", bet)
        else:
            add_stats(uid, False, 0)
            send_result(chat_id, "Выпало {}. Прогноз неверен: -{}".format(value, fmt(bet)), "dice", bet)

    threading.Timer(4.0, finish).start()


def spin_roulette(uid, chat_id, bet, choice):
    number = random.randint(0, 36)
    if number == 0:
        color = "зеро"
    elif number in ROULETTE_REDS:
        color = "красное"
    else:
        color = "чёрное"

    total = 0
    if choice == "red" and color == "красное":
        total = bet * 2
    elif choice == "black" and color == "чёрное":
        total = bet * 2
    elif choice == "green" and number == 0:
        total = bet * 36
    elif choice.startswith("num:") and int(choice[4:]) == number:
        total = bet * 36

    headline = "Выпало {} ({}).".format(number, color)
    if total:
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(chat_id, headline + " Выигрыш: +{}".format(fmt(total)), "roulette", bet)
    else:
        add_stats(uid, False, 0)
        send_result(chat_id, headline + " Ставка проиграна: -{}".format(fmt(bet)), "roulette", bet)


