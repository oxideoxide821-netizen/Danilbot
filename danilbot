def _render_chat_page(user_id, chat_id, message_id, account_id):
    data = chat_filters.get(user_id, {})
    dialogs = data.get('_dialogs', [])
    if not dialogs:
        cb_select_chats_raw(user_id, chat_id, message_id, account_id)
        return

    selected = get_selected_chats(user_id, account_id)
    selected_ids = {s[0] for s in selected}

    page = user_chat_pages.get(user_id, 0)
    per_page = 9
    total_pages = max(1, (len(dialogs) + per_page - 1) // per_page)
    if page >= total_pages:
        page = total_pages - 1
        user_chat_pages[user_id] = page
    start = page * per_page
    end = start + per_page
    page_dialogs = dialogs[start:end]

    kb = InlineKeyboardMarkup()
    for i in range(0, len(page_dialogs), 3):
        row = []
        for j in range(3):
            if i + j < len(page_dialogs):
                dialog = page_dialogs[i + j]
                cid = dialog.id
                name = dialog.name or f"Chat {cid}"
                chat_filters[user_id][cid] = name
                mark = "✅ " if cid in selected_ids else "⬜ "
                short = name[:12] + "..." if len(name) > 12 else name
                row.append(InlineKeyboardButton(f"{mark}{short}", callback_data=f"t:{cid}"))
        if row:
            kb.row(*row)

    nav_row = []
    if page > 0:
        nav_row.append(InlineKeyboardButton("⬅️ Назад", callback_data="chat_page_prev"))
    nav_row.append(InlineKeyboardButton(f"📄 {page + 1}/{total_pages}", callback_data="noop"))
    if page < total_pages - 1:
        nav_row.append(InlineKeyboardButton("Вперёд ➡️", callback_data="chat_page_next"))
    if nav_row:
        kb.row(*nav_row)

    kb.row(InlineKeyboardButton("🔄 Обновить список", callback_data="select_chats"))
    kb.row(InlineKeyboardButton("❌ Очистить выбор", callback_data="clear_chats"))
    kb.row(InlineKeyboardButton("◀️ Назад", callback_data="main_menu"))
    safe_edit_message(f"📋 Выберите чаты для рассылки (выбрано: {len(selected_ids)}):", chat_id, message_id, reply_markup=kb)


def cb_select_chats_raw(user_id, chat_id, message_id, account_id):
    acc = get_account(account_id)
    if not acc:
        safe_edit_message("❌ Аккаунт не найден.", chat_id, message_id, reply_markup=back_keyboard())
        return

    safe_edit_message("⏳ <b>Загрузка чатов...</b>\n\nПодождите, получаем список групп.", chat_id, message_id)

    started = manager.start_client(account_id, acc[2])
    if not started:
        safe_edit_message("❌ Не удалось подключить аккаунт. Попробуйте удалить и добавить заново.", chat_id, message_id, reply_markup=back_keyboard())
        return
    client = manager.get_client(account_id)
    if not client:
        safe_edit_message("❌ Ошибка подключения аккаунта.", chat_id, message_id, reply_markup=back_keyboard())
        return
    try:
        me = manager.run_sync(account_id, client.get_me(), timeout=15)
        me_id = me.id
    except:
        safe_edit_message("❌ Ошибка получения данных аккаунта.", chat_id, message_id, reply_markup=back_keyboard())
        return
    try:
        dialogs = manager.get_dialogs_cached(account_id, client, me_id, force_refresh=True)
    except Exception as e:
        safe_edit_message(f"❌ Ошибка загрузки чатов: {str(e)}", chat_id, message_id, reply_markup=back_keyboard())
        return

    chat_filters[user_id] = {'_dialogs': dialogs}
    _render_chat_page(user_id, chat_id, message_id, account_id)

