        bot.send_message(chat_id, "Сначала завершите текущую игру.")
        return
    user = get_user(uid)
    if bet is None:
        name, desc = GAMES[game]
        bot.send_message(chat_id, "{}\n{}\n\nВыберите ставку:".format(name, desc),
                         reply_markup=bet_keyboard(game))
        return
    if bet < MIN_BET:
        bot.send_message(chat_id, "Минимальная ставка — {}.".format(fmt(MIN_BET)))
        return
    if bet > MAX_BET:
        bot.send_message(chat_id, "Максимальная ставка — {}.".format(fmt(MAX_BET)))
        return
    if user[2] < bet:
        bot.send_message(chat_id, "Недостаточно средств. Ваш баланс: {}.".format(fmt(user[2])))
        return

    add_balance(uid, -bet)

    if game == "slots":
        play_slots(uid, chat_id, bet)
    elif game == "coin":
        pending[uid] = {"game": "coin", "bet": bet}
        bot.send_message(chat_id, "Ставка {} принята. Ваш выбор:".format(fmt(bet)), reply_markup=coin_kb())
    elif game == "dice":
        pending[uid] = {"game": "dice", "bet": bet}
        bot.send_message(chat_id, "Ставка {} принята. Ваш прогноз:".format(fmt(bet)), reply_markup=dice_kb())
    elif game == "roulette":
        pending[uid] = {"game": "roulette", "bet": bet}
        bot.send_message(chat_id, "Ставка {} принята. Ваш сектор:".format(fmt(bet)), reply_markup=roulette_kb())
    elif game == "guess":
        pending[uid] = {"game": "guess", "bet": bet}
        bot.send_message(chat_id, "Ставка {} принята. Угадайте число:".format(fmt(bet)), reply_markup=guess_kb())
    elif game == "bj":
        start_bj(uid, chat_id, bet)
    elif game == "crash":
