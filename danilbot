def buy_upgrade(user_id, username, chat_id, upgrade_key, message_id=None):
    user = get_user(user_id, username)
    upg = UPGRADES.get(upgrade_key)
    if not upg:
        return

    idx_map = {"lopata": 17, "seeds": 18, "greenhouse": 19}
    current_lvl = user[idx_map[upgrade_key]]
    price = upg["price"] * (current_lvl + 1)

    if user[2] < price:
        text = f"❌ Недостаточно монет! Нужно: {price:,}"
    else:
        add_field(user_id, "balance", -price)
        add_field(user_id, upgrade_key, 1)
        if upg["type"] == "farm_power":
            add_field(user_id, "farm_power", upg["bonus"])
        elif upg["type"] == "legendary_chance":
            add_field(user_id, "legendary_chance", upg["bonus"])
        text = f"✅ {upg['name']} куплено! (Уровень {current_lvl+1})"

    if message_id:
        safe_edit(chat_id, message_id, text, upgrades_menu_markup(user_id))
    else:
        bot.send_message(chat_id, text, reply_markup=upgrades_menu_markup(user_id))

