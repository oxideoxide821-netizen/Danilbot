def do_smoke(user_id, username, first_name, chat_id, item, message_id=None):
    user = get_user(user_id, username)

    if item == "joint":
        have, field, high, exp = user[6], "joints", 1, 10
        name = "косяк"
    elif item == "blunt":
        have, field, high, exp = user[7], "blunts", 3, 25
        name = "блант"
    elif item == "golden":
        have, field, high, exp = user[8], "golden_joints", 10, 100
        name = "золотой косяк"
    else:
        return

    if have < 1:
        text = f"❌ У тебя нет {name}а! Скрафть в меню крафта."
        if message_id:
            safe_edit(chat_id, message_id, text, smoke_menu(user_id))
        else:
            bot.send_message(chat_id, text, reply_markup=smoke_menu(user_id))
        return

    add_field(user_id, field, -1)
    add_field(user_id, "total_smoked", 1)
    add_field(user_id, "total_high", high)

    current_exp = user[12] + exp
    current_level = user[11]
    needed = current_level * 100
    new_level = current_level
    while current_exp >= needed:
        current_exp -= needed
        new_level += 1
        needed = new_level * 100

    if new_level > current_level:
        update_user(user_id, "level", new_level)
        update_user(user_id, "exp", current_exp)
        level_up = f"\n\n🎉 *LEVEL UP!* Теперь ты {new_level} уровня!"
    else:
        update_user(user_id, "exp", current_exp)
        level_up = ""

    phrase = random.choice(HIGH_PHRASES).format(name=first_name or username or "Курильщик", amount=high)
    text = f"{phrase}{level_up}\n\n📊 Всего покурено: {user[9]+1}\n🌀 Всего кайфа: {user[10]+high}"

    if message_id:
        safe_edit(chat_id, message_id, text, smoke_menu(user_id), parse_mode="Markdown")
    else:
        bot.send_message(chat_id, text, parse_mode="Markdown", reply_markup=smoke_menu(user_id))

