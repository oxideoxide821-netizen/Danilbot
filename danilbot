def broadcast_worker(user_id, chat_id, message_id):
    user = get_user(user_id)
    text = user[3] or ""
    interval = user[4] or 1.0
    mentions = user[5] or 0
    send_mode = user[7] if len(user) > 7 else 'all'

    manager.start_client(user_id, user[1])
    client = manager.get_client(user_id)
    if not client:
        try:
            bot.edit_message_text("❌ <b>Клиент не найден</b>\n\nНе удалось подключиться к аккаунту.", chat_id=chat_id, message_id=message_id)
        except:
            pass
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        return

    try:
        me = manager.run_sync(user_id, client.get_me(), timeout=30)
        dialogs = manager.run_sync(user_id, fetch_all_group_dialogs(client, me.id), timeout=600)

        if send_mode == 'selected':
            selected = get_selected_chats(user_id)
            selected_ids = {row[0] for row in selected}
            dialogs = [d for d in dialogs if d.id in selected_ids]

        if not dialogs:
            try:
                bot.edit_message_text("❌ <b>Нет чатов для рассылки</b>\n\nДля режима «Выбранные чаты» необходимо выбрать хотя бы один чат в разделе 📋 Чаты для рассылки.", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
            except:
                pass
            db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
            return

        total = len(dialogs)
        sent = 0
        failed = 0

        for idx, dialog in enumerate(dialogs):
            user = get_user(user_id)
            if not user[6]:
                remaining = total - idx
                try:
                    bot.edit_message_text(f"⏹ <b>Рассылка остановлена пользователем</b>\n\n📋 Всего чатов: {total}\n✅ Успешно отправлено: {sent}\n❌ Ошибок: {failed}\n📋 Не обработано: {remaining}\n\n⏱ Интервал: {interval} сек.", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
                except:
                    pass
                db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
                return

            entity = dialog.entity
            msg_text = text + FOOTER_TEXT

            if mentions and hasattr(entity, 'id'):
                try:
                    participants = manager.run_sync(user_id, client.get_participants(entity, limit=10), timeout=15)
                    tags = []
                    for p in participants:
                        tags.append(f'<a href="tg://user?id={p.id}">\u200b</a>')
                    if tags:
                        msg_text = text + "\n\n" + "".join(tags[:10]) + FOOTER_TEXT
                except Exception:
                    pass

            try:
                manager.run_sync(user_id, client.send_message(entity, msg_text, parse_mode='html'), timeout=30)
                sent += 1
            except FloodWaitError as e:
                try:
                    bot.send_message(user_id, f"⚠️ <b>FloodWait</b>\n\nTelegram требует подождать {e.seconds} сек. из-за слишком частой отправки. Ждём...")
                except:
                    pass
                time.sleep(min(e.seconds, 300))
                try:
                    manager.run_sync(user_id, client.send_message(entity, msg_text, parse_mode='html'), timeout=30)
                    sent += 1
                except:
                    failed += 1
            except Exception:
                failed += 1

            if idx % 5 == 0:
                remaining = total - idx - 1
                try:
                    status_text = f"📊 <b>Статус рассылки</b>\n\n📋 Всего чатов: {total}\n✅ Успешно отправлено: {sent}\n❌ Ошибок: {failed}\n📋 Осталось: {remaining}\n⏳ Обработано: {idx+1}/{total}\n\n⏱ Интервал: {interval} сек."
                    bot.edit_message_text(status_text, chat_id=chat_id, message_id=message_id, reply_markup=stop_keyboard())
                except:
                    pass

            time.sleep(interval)

        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        final_text = f"✅ <b>Рассылка завершена</b>\n\n📋 Всего чатов обработано: {total}\n✅ Успешно отправлено: {sent}\n❌ Ошибок: {failed}\n\n📨 Ваше сообщение доставлено по указанным чатам."
        try:
            bot.edit_message_text(final_text, chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
        except:
            pass
    except Exception as e:
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        try:
            bot.edit_message_text(f"❌ <b>Критическая ошибка рассылки</b>\n\n{str(e)}\n\nПопробуйте перезапустить.", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
        except:
            pass

