    bot.edit_message_text("⭐ Выбери оценку:", c.message.chat.id, c.message.message_id, reply_markup=kb_rate(item_id))

@bot.callback_query_handler(func=lambda c: c.data.startswith('rate_'))
def cb_rate(c):
    bot.answer_callback_query(c.id)
    parts = c.data.split('_')
    item_id = int(parts[1])
    rating = int(parts[2])
    uid = c.from_user.id
    user_data[uid] = {'rev_item': item_id, 'rev_rating': rating}
    user_state[uid] = STATE_REVIEW_TEXT
    bot.edit_message_text("📝 Напиши текст отзыва:", c.message.chat.id, c.message.message_id)

@bot.message_handler(func=lambda m: user_state.get(m.from_user.id) == STATE_REVIEW_TEXT)
def step_review(m):
    uid = m.from_user.id
    d = user_data.get(uid, {})
    item_id = d.get('rev_item')
    rating = d.get('rev_rating')
    if not item_id:
        return
    
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT seller_id FROM items WHERE id=?", (item_id,))
    row = cur.fetchone()
    if not row:
        bot.send_message(m.chat.id, "❌ Товар не найден.", reply_markup=kb_main())
        return
    seller_id = row[0]
    
    cur.execute("INSERT INTO reviews (item_id, seller_id, buyer_id, buyer_name, rating, text, created_at) VALUES (?,?,?,?,?,?,?)",
                (item_id, seller_id, uid, m.from_user.username or m.from_user.first_name, rating, m.text.strip(),
                 datetime.now().strftime("%Y-%m-%d %H:%M")))
    conn.commit()
    conn.close()
    
    bot.send_message(m.chat.id, "✅ Отзыв оставлен! Спасибо.", reply_markup=kb_main())
    user_state.pop(uid, None)
    user_data.pop(uid, None)

