class PhoneAuthManager:
    def __init__(self):
        self.pending = {}

    def start_auth(self, user_id, chat_id, bot_instance):
        if user_id in self.pending:
            bot_instance.send_message(chat_id, "⏳ Авторизация уже идёт.")
            return
        self.pending[user_id] = {
            'chat_id': chat_id, 'phone': None, 'client': None, 'loop': None,
            'code_event': threading.Event(), 'code_value': None,
            'password_event': threading.Event(), 'password_value': None,
            'cancelled': False
        }
        bot_instance.send_message(chat_id, "📱 <b>Авторизация по номеру</b>\n\nВведите номер телефона в формате <code>+79991234567</code>:", reply_markup=cancel_auth_keyboard())
        user_states[user_id] = 'phone_input'

    def submit_phone(self, user_id, phone):
        if user_id not in self.pending or self.pending[user_id].get('cancelled'):
            return False
        self.pending[user_id]['phone'] = phone
        threading.Thread(target=self._auth_thread, args=(user_id,), daemon=True).start()
        return True

    def submit_code(self, user_id, code):
        if user_id in self.pending and not self.pending[user_id].get('cancelled'):
            self.pending[user_id]['code_value'] = code
            self.pending[user_id]['code_event'].set()
            return True
        return False

    def submit_password(self, user_id, password):
        if user_id in self.pending and not self.pending[user_id].get('cancelled'):
            self.pending[user_id]['password_value'] = password
            self.pending[user_id]['password_event'].set()
            return True
        return False

    def cancel(self, user_id):
        if user_id in self.pending:
            self.pending[user_id]['cancelled'] = True
            self.pending[user_id]['code_event'].set()
            self.pending[user_id]['password_event'].set()
            p = self.pending[user_id]
            if p.get('client') and p.get('loop'):
                try:
                    asyncio.run_coroutine_threadsafe(p['client'].disconnect(), p['loop']).result(timeout=5)
                except:
                    pass
            del self.pending[user_id]
            return True
        return False

