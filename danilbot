async def get_members_for_mentions(client, chat_id, count):
    members = []
    try:
        async for user in client.iter_participants(chat_id, limit=count * 3):
            if user.bot:
                continue
            if user.deleted:
                continue
            members.append(user)
            if len(members) >= count:
                break
    except Exception:
        pass
    random.shuffle(members)
    return members[:count]

def build_mention_text(client, members):
    parts = []
    for m in members:
        if m.username:
            parts.append(f"@{m.username}")
        else:
            name = (m.first_name or '') + (f" {m.last_name}" if m.last_name else '')
            parts.append(f'<a href="tg://user?id={m.id}">{html.escape(name or "User")}</a>')
    return " ".join(parts)

async def send_to_chat(client, chat_id, text, mentions_mode, mentions_count):
    final_text = text
    if mentions_mode != 'none' and mentions_count > 0:
        members = await get_members_for_mentions(client, chat_id, mentions_count)
        if members:
            mention_text = build_mention_text(client, members)
            final_text = f"{mention_text}\n\n{text}"
    try:
        await client.send_message(chat_id, final_text, parse_mode='html', link_preview=False)
        return True
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        try:
            await client.send_message(chat_id, final_text, parse_mode='html', link_preview=False)
            return True
        except:
            return False
    except Exception:
        return False

def broadcast_worker(user_id, account_id, chat_ids, text, interval, duration_hours, msgs_per_chat, mentions_mode, mentions_count):
    start_time = time.time()
    duration_seconds = duration_hours * 3600 if duration_hours > 0 else None

    success = 0
    failed = 0

    while True:
        if duration_seconds and (time.time() - start_time) >= duration_seconds:
            break

        user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
        if not user_row or not user_row[0]:
            break

        client = manager.get_client(account_id)
        if not client:
            time.sleep(5)
            continue

        for chat_id in chat_ids:
            user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
            if not user_row or not user_row[0]:
                break

            for _ in range(msgs_per_chat):
                user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
                if not user_row or not user_row[0]:
                    break

                try:
                    result = manager.run_sync(account_id, send_to_chat(client, chat_id, text, mentions_mode, mentions_count), timeout=60)
                    if result:
                        success += 1
                    else:
                        failed += 1
                except Exception:
                    failed += 1

                time.sleep(interval)

            if duration_seconds and (time.time() - start_time) >= duration_seconds:
                break

        if duration_seconds and (time.time() - start_time) >= duration_seconds:
            break

    db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
    try:
        bot.send_message(user_id, f"⏹ <b>Рассылка завершена!</b>\n\n✅ Успешно: {success}\n❌ Ошибок: {failed}", reply_markup=main_menu_keyboard(has_accounts(user_id)))
    except:
        pass

