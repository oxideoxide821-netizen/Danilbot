@bot.message_handler(content_types=['video'], func=lambda m: user_state.get(m.from_user.id) == STATE_SELL_VIDEO)
def step_video(m):
    uid = m.from_user.id
    if 'videos' not in user_data[uid]:
        user_data[uid]['videos'] = []
    if len(user_data[uid]['videos']) >= 10:
        bot.send_message(m.chat.id, "❌ Максимум 10 видео. Напиши <b>готово</b> или /skip:")
        return
    user_data[uid]['videos'].append(m.video.file_id)
    count = len(user_data[uid]['videos'])
    bot.send_message(m.chat.id, f"🎥 Видео добавлено ({count}/10). Отправь ещё или напиши <b>готово</b>:", parse_mode='HTML')

@bot.message_handler(func=lambda m: user_state.get(m.from_user.id) == STATE_SELL_VIDEO)
def step_video_done(m):
    uid = m.from_user.id
    text = m.text.strip().lower()
    if text in ('готово', 'готово!', '/skip', 'пропустить', 'skip'):
