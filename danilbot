def expire_pending(uid):
    """Если игрок не выбрал вариант за PENDING_TTL — возвращаем ставку."""
    s = pending.get(uid)
    if s and s.get("paid") and time.time() - s["t"] > PENDING_TTL:
        pending.pop(uid, None)
        add_balance(uid, s["bet"])


def is_busy(uid):
    expire_pending(uid)
    return (uid in pending or uid in bj_games or uid in rolling or
            (uid in crash_rounds and crash_rounds[uid]["active"]))


def set_pending(uid, game, bet):
    pending[uid] = {"game": game, "bet": bet, "paid": True, "t": time.time()}


def begin_game(uid, chat_id, game, bet):
    # ожидание ввода своей ставки не должно блокировать выбор другой игры
    if pending.get(uid, {}).get("await") == "bet":
        pending.pop(uid, None)
    if is_busy(uid):
        bot.send_message(chat_id, "Сначала завершите текущую игру.")
        return
    user = get_user(uid)
    if bet is None:
        name, desc = GAMES[game]
        bot.send_message(chat_id, "{}\n{}\n\nВыберите ставку:".format(name, desc),
                         reply_markup=bet_keyboard(game))
        return
    if bet < MIN_BET:
        bot.send_message(chat_id, "Минимальная ставка — {}.".format(fmt(MIN_BET)))
        return
    if bet > MAX_BET:
        bot.send_message(chat_id, "Максимальная ставка — {}.".format(fmt(MAX_BET)))
        return
    if not try_charge(uid, bet):
        tip = ""
        if user[U_BAL] < MIN_BET:
            tip = "\nДеньги кончились? Напишите «подачка» или заберите «бонус»."
        bot.send_message(chat_id, "Недостаточно средств. Ваш баланс: {}.{}".format(fmt(user[U_BAL]), tip))
        return

    if game == "slots":
        play_slots(uid, chat_id, bet)
    elif game == "wheel":
        play_wheel(uid, chat_id, bet)
    elif game == "bj":
        start_bj(uid, chat_id, bet)
    elif game == "crash":
        launch_crash(uid, chat_id, bet)
    else:
        prompts = {
            "coin": ("Ваш выбор:", coin_kb),
