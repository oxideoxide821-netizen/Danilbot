# ================== QR AUTH MANAGER (только для админов) ==================
class QRAuthManager:
    def __init__(self):
        self.pending = {}

    def start_auth(self, user_id, chat_id, bot_instance, mode='account'):
        if user_id in self.pending:
            bot_instance.send_message(chat_id, "⏳ Авторизация уже идёт.")
            return
        if not HAS_QR:
            bot_instance.send_message(chat_id, "❌ Установи: pip install qrcode[pil]")
            return

        self.pending[user_id] = {
            'mode': mode,
            'chat_id': chat_id,
            'password_event': threading.Event(),
            'password_value': None,
            'email_event': threading.Event(),
            'email_value': None,
            'cancelled': False,
            'needs_email': False
        }

        def auth_thread():
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            session = StringSession()
            client = TelegramClient(session, API_ID, API_HASH, loop=loop)

            async def do_auth():
                try:
                    await client.connect()
                    if await client.is_user_authorized():
                        me = await client.get_me()
                        ss = client.session.save()
                        await handle_success(ss, me)
                        return

                    qr_login = await client.qr_login()
                    url = qr_login.url

                    qr = qrcode.QRCode(version=1, box_size=10, border=2)
                    qr.add_data(url)
                    qr.make(fit=True)
                    img = qr.make_image(fill_color="black", back_color="white")
                    buf = io.BytesIO()
                    img.save(buf, format='PNG')
                    buf.seek(0)

                    bot_instance.send_photo(
                        chat_id, buf,
                        caption="🔐 <b>Авторизация аккаунта через QR</b>\n\n"
                                "1. Откройте Telegram на телефоне\n"
                                "2. Настройки → Устройства → Подключить десктопное устройство\n"
                                "3. Отсканируйте этот QR-код\n\n"
                                "⏳ Ожидание сканирования (до 2 минут)...",
                        reply_markup=cancel_auth_keyboard()
                    )

                    try:
                        await asyncio.wait_for(qr_login.wait(), timeout=120)
                    except asyncio.TimeoutError:
                        bot_instance.send_message(
                            chat_id,
                            "❌ <b>Время ожидания истекло</b>\n\nQR-код был активен 2 минуты.",
                            reply_markup=admin_menu_keyboard()
                        )
                        return

                except SessionPasswordNeededError:
                    bot_instance.send_message(
                        chat_id,
                        "🔒 <b>Требуется пароль 2FA</b>\n\nВведите пароль от аккаунта:",
                        reply_markup=cancel_auth_keyboard()
                    )
                    self.pending[user_id]['password_event'].wait()
                    if self.pending[user_id].get('cancelled'):
                        return
                    password = self.pending[user_id]['password_value']
                    try:
                        await client.sign_in(password=password)
                    except Exception as e:
                        error_text = str(e).lower()
                        if 'email' in error_text or 'e-mail' in error_text or 'код' in error_text:
                            bot_instance.send_message(
                                chat_id,
                                "📧 <b>Требуется код из Email</b>\n\nВведите код:",
                                reply_markup=cancel_auth_keyboard()
                            )
                            self.pending[user_id]['needs_email'] = True
                            self.pending[user_id]['email_event'].wait()
                            if self.pending[user_id].get('cancelled'):
                                return
                            email_code = self.pending[user_id]['email_value']
                            try:
                                await client.sign_in(code=email_code)
                            except Exception as e2:
                                bot_instance.send_message(
                                    chat_id,
                                    f"❌ Ошибка: {str(e2)}",
                                    reply_markup=admin_menu_keyboard()
                                )
                                return
                        else:
                            bot_instance.send_message(
                                chat_id,
                                f"❌ Ошибка пароля: {str(e)}",
                                reply_markup=admin_menu_keyboard()
                            )
                            return
                except Exception as e:
                    bot_instance.send_message(
                        chat_id,
                        f"❌ Ошибка: {str(e)}",
                        reply_markup=admin_menu_keyboard()
                    )
                    return

                if await client.is_user_authorized():
                    me = await client.get_me()
                    ss = client.session.save()
                    await handle_success(ss, me)
                else:
                    bot_instance.send_message(
                        chat_id,
                        "❌ Авторизация не удалась.",
                        reply_markup=admin_menu_keyboard()
                    )

                await client.disconnect()

            async def handle_success(ss, me):
                phone = me.phone or "unknown"
                mode = self.pending[user_id]['mode']
                if mode == 'account':
                    user_states[user_id] = 'waiting_price'
                    user_states[f'{user_id}_temp_session'] = ss
                    user_states[f'{user_id}_temp_phone'] = phone
                    bot_instance.send_message(
                        chat_id,
                        f"✅ <b>Аккаунт авторизован!</b>\n\n"
                        f"📱 Номер: <code>{phone}</code>\n\n"
                        f"Введите цену продажи (только число, например 500):",
                        reply_markup=cancel_auth_keyboard()
                    )
                else:
                    bot_instance.send_message(
                        chat_id,
                        f"✅ Авторизация успешна!",
                        reply_markup=main_menu_keyboard()
                    )

            try:
                loop.run_until_complete(do_auth())
            finally:
                try:
                    loop.run_until_complete(client.disconnect())
                except:
                    pass
            if user_id in self.pending:
                del self.pending[user_id]

        t = threading.Thread(target=auth_thread, daemon=True)
        t.start()

    def submit_password(self, user_id, password):
        if user_id in self.pending:
            self.pending[user_id]['password_value'] = password
            self.pending[user_id]['password_event'].set()
            return True
        return False

    def submit_email(self, user_id, code):
        if user_id in self.pending:
            self.pending[user_id]['email_value'] = code
            self.pending[user_id]['email_event'].set()
            return True
        return False

    def cancel(self, user_id):
        if user_id in self.pending:
            self.pending[user_id]['cancelled'] = True
            self.pending[user_id]['password_event'].set()
            self.pending[user_id]['email_event'].set()
            del self.pending[user_id]
            return True
        return False

