@app.post("/api/accounts/{idx}/dialogs/{peer}/send")
async def send_message(idx: int, peer: int, data: Message):
    a = acc_or_404(idx)
    text = data.text.strip()
    if not text:
        raise HTTPException(400, "Пустое сообщение.")
    if len(text) > 4096:
        raise HTTPException(400, "Максимум 4096 символов.")
    try:
        entity = await a["client"].get_input_entity(peer)
        sent = await a["client"].send_message(entity, text, reply_to=data.reply_to)
        return {"ok": True, "id": sent.id}
    except Exception as e:
        raise HTTPException(400, str(e))


def split_words(text: str, count: int):
    words = text.split()
    count = max(1, min(int(count), 100))
    return [" ".join(words[i:i + count]) for i in range(0, len(words), count)]

async def queue_worker(idx: int, peer: int, chunks: list, delay: float, reply_to):
    global queue_state
    a = accounts.get(idx)
    if not a:
        queue_state["last_error"] = "Аккаунт отключён."
        queue_state["task"] = None
        return
    try:
        entity = await a["client"].get_input_entity(peer)
        # Apply the user's delay setting equally in private chats and groups.
        # Telegram-side FloodWait limits are still handled below.
        effective_delay = float(delay)
        for chunk in chunks:
            while queue_state["paused"] and not queue_state["stop"]:
                await asyncio.sleep(0.2)
            if queue_state["stop"]:
                break
            if queue_state["caps"]:
                chunk = chunk.upper()
            try:
                # Как в оригинале: запускаем отправку без ожидания ответа Telegram.
                # Интервал между постановками отправок регулируется delay ниже.
                async def _send_and_track(client, target, message, reply):
                    try:
                        await client.send_message(target, message, reply_to=reply)
                        queue_state["sent"] += 1
                    except Exception as send_error:
                        queue_state["last_error"] = str(send_error)
                    finally:
                        queue_state["pending"] = max(0, queue_state.get("pending", 0) - 1)
                        queue_state["remaining"] = max(0, queue_state["total"] - queue_state["sent"] - queue_state.get("pending", 0))
                queue_state["pending"] = queue_state.get("pending", 0) + 1
                queue_state["remaining"] = max(0, queue_state["total"] - queue_state["sent"] - queue_state["pending"])
                asyncio.create_task(_send_and_track(a["client"], entity, chunk, reply_to))
            except Exception as e:
                try:
                    from telethon.errors import FloodWaitError
                    if isinstance(e, FloodWaitError):
                        queue_state["last_error"] = (
                            f"Telegram ограничил отправку (FloodWait {e.seconds} сек.). "
                            "Очередь остановлена — дождитесь срока и запустите продолжение."
                        )
                    else:
                        queue_state["last_error"] = str(e)
                except Exception:
                    queue_state["last_error"] = str(e)
                queue_state["paused"] = True
                break
            base_delay = max(0.05, min(float(effective_delay), 60.0))
            # В оригинале rand-режим слегка меняет задержку для каждой части.
            cur_delay = random.uniform(base_delay * 0.5, base_delay * 1.5) if queue_state.get("randomized") else base_delay
            await asyncio.sleep(cur_delay)
        if queue_state["stop"]:
            queue_state["last_error"] = "Очередь остановлена."
        elif not queue_state["last_error"]:
            queue_state["last_error"] = "Очередь завершена."
    finally:
        queue_state["task"] = None
        queue_state["paused"] = False
        queue_state["stop"] = False

@app.post("/api/accounts/{idx}/dialogs/{peer}/queue")
async def start_queue(idx: int, peer: int, data: QueueRequest):
    if idx not in accounts:
        raise HTTPException(404, "Аккаунт не найден.")
    if queue_state["task"] is not None:
        raise HTTPException(409, "Уже есть активная очередь. Дождитесь завершения или остановите её.")
    text = data.text.strip()
    if not text:
        raise HTTPException(400, "Введите текст.")
    words = text.split()
    chunks = []
    if data.random_max > 0:
        pos = 0
        while pos < len(words):
            n = random.randint(1, max(1, min(data.random_max, 20)))
            chunks.append(" ".join(words[pos:pos+n]))
            pos += n
    else:
        chunks = split_words(text, data.words_per_message)
    if any(len(c) > 4096 for c in chunks):
        raise HTTPException(400, "Одна часть превышает лимит Telegram в 4096 символов.")
    queue_state.update({"paused": False, "stop": False, "remaining": len(chunks), "pending": 0,
                        "sent": 0, "total": len(chunks), "account": idx, "peer": peer,
                        "chat_name": str(peer), "last_error": "", "randomized": data.random_max > 0})
    queue_state["task"] = asyncio.create_task(queue_worker(idx, peer, chunks, data.delay, data.reply_to))
    return {"ok": True, "parts": len(chunks)}

@app.get("/api/queue")
async def get_queue():
    return {k: v for k, v in queue_state.items() if k != "task"} | {"active": queue_state["task"] is not None}

@app.post("/api/queue/pause")
async def pause_queue():
    if queue_state["task"] is None:
        raise HTTPException(400, "Очередь не запущена.")
    queue_state["paused"] = True
    return {"ok": True}

@app.post("/api/queue/resume")
async def resume_queue():
    if queue_state["task"] is None:
        raise HTTPException(400, "Очередь не запущена.")
    queue_state["last_error"] = ""
    queue_state["paused"] = False
    return {"ok": True}

@app.post("/api/queue/stop")
async def stop_queue():
    queue_state["stop"] = True
    queue_state["paused"] = False
    return {"ok": True}

@app.post("/api/queue/caps")
async def toggle_caps():
    queue_state["caps"] = not queue_state["caps"]
    return {"caps": queue_state["caps"]}

@app.post("/api/accounts/{idx}/dialogs/{peer}/photo")
async def download_photo(idx: int, peer: int):
    a = acc_or_404(idx)
    try:
        entity = await a["client"].get_input_entity(peer)
        msgs = await a["client"].get_messages(entity, limit=50)
        for msg in msgs:
            if msg.photo:
                path = await msg.download_media(file=str(DOWNLOAD_DIR) + os.sep)
                if path:
                    return {"ok": True, "filename": Path(path).name, "url": "/downloads/" + Path(path).name}
        raise HTTPException(404, "Фото в последних 50 сообщениях не найдено.")
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(400, str(e))

@app.get("/downloads/{filename}")
async def download_file(filename: str):
    path = (DOWNLOAD_DIR / Path(filename).name).resolve()
    if not path.exists() or DOWNLOAD_DIR.resolve() not in path.parents:
        raise HTTPException(404, "Файл не найден.")
    return FileResponse(path, filename=path.name)

@app.delete("/api/accounts/{idx}")
async def remove_account(idx: int):
    a = accounts.pop(idx, None)
    if a:
        await a["client"].disconnect()
    p = pending.pop(idx, None)
    if p:
        await p["client"].disconnect()
    return {"ok": True}

