def cmd_daily(message):
    uid = message.from_user.id
    user = get_user(uid)
    now = time.time()
    if now - user[7] < DAILY_INTERVAL:
        left = int(user[7] + DAILY_INTERVAL - now)
        hours, minutes = left // 3600, (left % 3600) // 60
        bot.reply_to(message, "Бонус уже получен. Следующий через {} ч {} мин.".format(hours, minutes))
        return
    add_balance(uid, DAILY_BONUS)
    db_query("UPDATE users SET last_daily=? WHERE user_id=?", (now, uid))
    bot.reply_to(message, "Ежедневный бонус {} зачислен. Баланс: {}.".format(fmt(DAILY_BONUS), fmt(get_user(uid)[2])))


def cmd_transfer(message, args):
    uid = message.from_user.id
    if len(args) < 2:
        bot.reply_to(message, "Формат: передать <сумма> <@ник>")
        return
    amount = parse_amount(args[0])
    if amount is None or amount < 1:
        bot.reply_to(message, "Некорректная сумма.")
        return
    target_name = args[1].lstrip("@").lower()
    if target_name == (message.from_user.username or "").lower():
        bot.reply_to(message, "Нельзя передать средства самому себе.")
        return
    row = db_query("SELECT user_id, balance FROM users WHERE username=?", (target_name,), "one")
    if not row:
        bot.reply_to(message, "Игрок с ником @{} не найден.".format(target_name))
        return
    if get_user(uid)[2] < amount:
        bot.reply_to(message, "Недостаточно средств.")
        return
    add_balance(uid, -amount)
    add_balance(row[0], amount)
    bot.reply_to(message, "Передано {} игроку @{}. Ваш баланс: {}.".format(
        fmt(amount), target_name, fmt(get_user(uid)[2])))


def cmd_give(message, args):
    if message.from_user.id != ADMIN_ID:
        bot.reply_to(message, "Команда доступна только администратору.")
        return
    if len(args) < 2:
        bot.reply_to(message, "Формат: give <сумма> <@ник>")
        return
    amount = parse_amount(args[0])
    target_name = args[1].lstrip("@").lower()
    row = db_query("SELECT user_id FROM users WHERE username=?", (target_name,), "one")
    if amount is None or not row:
        bot.reply_to(message, "Некорректные параметры.")
        return
    add_balance(row[0], amount)
    bot.reply_to(message, "Зачислено {} игроку @{}.".format(fmt(amount), target_name))


