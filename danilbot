def extract_target(text):
    """Извлекает цель: @username, t.me/ссылка, или числовой ID чата"""
    text = text.strip()

    match = re.search(r't\.me/([a-zA-Z0-9_]{5,})', text)
    if match:
        return match.group(1)

    match = re.search(r'@([a-zA-Z0-9_]{5,})', text)
    if match:
        return match.group(1)

    match = re.search(r'^(-?\d+)$', text)
    if match:
        return int(match.group(1))

    if re.match(r'^[a-zA-Z][a-zA-Z0-9_]{4,}$', text):
        return text

    return None


def get_chat_id_from_fwd(fwd_from):
    """Получает ID чата из пересланного сообщения"""
    # Пробуем saved_from_peer
    if fwd_from.saved_from_peer:
        peer = fwd_from.saved_from_peer
        if isinstance(peer, PeerChannel):
            return peer.channel_id
        elif isinstance(peer, PeerChat):
            return peer.chat_id
        elif isinstance(peer, PeerUser):
            return peer.user_id

    # Пробуем saved_from_id
    if fwd_from.saved_from_id:
        peer = fwd_from.saved_from_id
        if isinstance(peer, PeerChannel):
            return peer.channel_id
        elif isinstance(peer, PeerChat):
            return peer.chat_id
        elif isinstance(peer, PeerUser):
            return peer.user_id

    # Пробуем from_id (отправитель, fallback)
    if fwd_from.from_id:
        peer = fwd_from.from_id
        if isinstance(peer, PeerChannel):
            return peer.channel_id
        elif isinstance(peer, PeerChat):
            return peer.chat_id
        elif isinstance(peer, PeerUser):
            return peer.user_id

    return None


@client.on(events.NewMessage(outgoing=True, chats='me'))
async def safe_stealth_spam(event):
    text = event.text.strip()

    if not text or not text.isupper():
        return

    target_chat = None
    spam_text = ""

    # === СЛУЧАЙ 1: Ответ на пересланное сообщение ===
    if event.is_reply:
        reply_msg = await event.get_reply_message()
        if reply_msg:
            if reply_msg.fwd_from:
                # === ОТЛАДКА: показываем что видим в fwd_from ===
                fwd = reply_msg.fwd_from
                debug_info = f"📋 Отладка fwd_from:\n"
                debug_info += f"saved_from_peer: {fwd.saved_from_peer}\n"
                debug_info += f"saved_from_id: {fwd.saved_from_id}\n"
                debug_info += f"from_id: {fwd.from_id}\n"
                debug_info += f"post_author: {fwd.post_author}\n"
                debug_info += f"date: {fwd.date}\n"

                # Пробуем получить ID всеми способами
                target_chat = get_chat_id_from_fwd(fwd)

                if not target_chat:
                    # Если не получилось — показываем отладку и просим ID
                    await event.reply(debug_info + "\n❌ Не удалось определить чат. Используй @username или ID чата.")
                    return
                else:
                    # Показываем что нашли
                    await event.reply(f"✅ Найден чат: {target_chat}")
            else:
                await event.reply("❌ Ответь на ПЕРЕСЛАННОЕ сообщение из целевого чата, чтобы я понял куда слать.")
                return

            spam_text = text

    # === СЛУЧАЙ 2: Без ответа — @username, t.me/ссылка или ID ===
    if not target_chat:
        parts = text.split(maxsplit=1)
        if len(parts) < 2:
            await event.reply("❌ Формат: `@ЮЗЕРНЕЙМ ТЕКСТ` или `-1001234567890 ТЕКСТ` (всё капсом)")
            return

        raw_target = parts[0]
        spam_text = parts[1]

        target_chat = extract_target(raw_target)
        if not target_chat:
            await event.reply("❌ Не понял куда слать. Используй @username, t.me/ссылку или ID чата")
            return

    # === РАЗДЕЛЕНИЕ НА ПАКЕТЫ ===
    messages_to_send = []
    for packet in spam_text.split():
        words = packet.split('/')
        message = ' '.join(words)
        messages_to_send.append(message)

    # Отчёт в Избранном
    await event.reply(f"⏳ Быстрый запуск на {target_chat}... ({len(messages_to_send)} сообщений)")

    try:
        for msg in messages_to_send:
            await client.send_message(target_chat, msg)
            await asyncio.sleep(random.uniform(0.0, 0.01))

    except Exception as e:
        await event.reply(f"❌ Ошибка: {e}")
        print(f"Ошибка отправки: {e}")

