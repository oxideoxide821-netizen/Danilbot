    return bool(user[1] and user[2] == 'done')

def get_selected_chats(user_id):
    return db_query("SELECT chat_id, chat_name FROM selected_chats WHERE user_id=?", (user_id,))

def toggle_chat_selection(user_id, chat_id, chat_name):
    existing = db_query("SELECT 1 FROM selected_chats WHERE user_id=? AND chat_id=?", (user_id, chat_id), fetchone=True)
    if existing:
        db_query("DELETE FROM selected_chats WHERE user_id=? AND chat_id=?", (user_id, chat_id))
        return False
    else:
        db_query("INSERT OR REPLACE INTO selected_chats (user_id, chat_id, chat_name) VALUES (?,?,?)", (user_id, chat_id, chat_name))
        return True

