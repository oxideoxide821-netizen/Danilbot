def get_user(user_id):
    row = db_query("SELECT * FROM users WHERE user_id=?", (user_id,), fetchone=True)
    if not row:
        db_query("INSERT INTO users (user_id) VALUES (?)", (user_id,))
        row = db_query("SELECT * FROM users WHERE user_id=?", (user_id,), fetchone=True)
    return row

def is_authorized(user_id):
