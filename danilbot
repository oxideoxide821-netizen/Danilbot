def do_daily(user_id, username, chat_id, message_id=None):
    user = get_user(user_id, username)
    now = int(time.time())
    last = user[16]

    if now - last < DAILY_COOLDOWN:
        wait = DAILY_COOLDOWN - (now - last)
        hours, rem = divmod(wait, 3600)
        mins, secs = divmod(rem, 60)
        text = f"⏳ Следующий бонус через *{hours}ч {mins}м {secs}с*"
    else:
        reward = random.randint(100, 500)
        add_field(user_id, "balance", reward)
        update_user(user_id, "last_daily", now)
        text = f"🎁 *Ежедневный бонус получен!*\n\n💰 +{reward} монет"

    if message_id:
        safe_edit(chat_id, message_id, text, back_button(user_id))
    else:
        bot.send_message(chat_id, text, parse_mode="Markdown", reply_markup=back_button(user_id))

