    text = m.text.strip()
    if not text.isdigit():
        bot.send_message(m.chat.id, "❌ Введи числовой ID:")
        return
    unban_uid = int(text)
    conn = get_db()
    cur = conn.cursor()
    cur.execute("DELETE FROM bans WHERE user_id=?", (unban_uid,))
    conn.commit()
    conn.close()
    bot.send_message(m.chat.id, f"✅ Пользователь <code>{unban_uid}</code> разбанен.", reply_markup=kb_bans_sub(), parse_mode='HTML')
    user_state.pop(uid, None)

@bot.callback_query_handler(func=lambda c: c.data == 'ban_list')
def cb_ban_list(c):
    bot.answer_callback_query(c.id)
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT user_id, reason, banned_at FROM bans")
    rows = cur.fetchall()
    conn.close()
    if not rows:
        bot.edit_message_text("🚫 <b>Банов нет.</b>", c.message.chat.id, c.message.message_id, reply_markup=kb_bans_sub(), parse_mode='HTML')
        return
    txt = "🚫 <b>Список забаненных:</b>\n\n"
    for r in rows:
        txt += f"• <code>{r[0]}</code> — {r[1]} ({r[2]})\n"
    bot.edit_message_text(txt, c.message.chat.id, c.message.message_id, reply_markup=kb_bans_sub(), parse_mode='HTML')

# --- Статистика ---

@bot.callback_query_handler(func=lambda c: c.data == 'admin_stats')
def cb_admin_stats(c):
    bot.answer_callback_query(c.id)
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT COUNT(*) FROM users")
    users = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM items WHERE status='approved'")
    items = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM items WHERE status='pending'")
    pending = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM purchases WHERE status='confirmed'")
    sales = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM reviews")
    reviews = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM bans")
    bans = cur.fetchone()[0]
    conn.close()
    
    txt = (f"📊 <b>Статистика бота</b>\n\n"
           f"👤 Пользователей: {users}\n"
           f"📦 Товаров одобрено: {items}\n"
           f"⏳ На модерации: {pending}\n"
           f"🛒 Продаж: {sales}\n"
           f"💬 Отзывов: {reviews}\n"
           f"🚫 Банов: {bans}")
    bot.edit_message_text(txt, c.message.chat.id, c.message.message_id, reply_markup=kb_admin(), parse_mode='HTML')

