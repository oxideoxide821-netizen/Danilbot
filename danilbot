def handle_awaiting(message, word):
    """Обработка ввода, когда бот ждёт данные от пользователя."""
    uid = message.from_user.id
    state = pending.get(uid)
    if not state:
        return False
    if word in ("отмена", "отменить", "cancel", "стоп"):
        pending.pop(uid, None)
        bot.reply_to(message, "Действие отменено.")
        return True
    if state.get("await") == "num":  # число для рулетки
        number = parse_amount(word)
        if number is None or not (0 <= number <= 36):
            bot.reply_to(message, "Введите число от 0 до 36 (или «отмена»).")
            return True
        pending.pop(uid, None)
        spin_roulette(uid, message.chat.id, state["bet"], "num:{}".format(number))
        return True
    # своя ставка
    amount = parse_amount(word)
    if amount is None:
        bot.reply_to(message, "Введите сумму числом, например: 500 или 2к.")
        return True
    game = state["game"]
    pending.pop(uid, None)
    begin_game(uid, message.chat.id, game, amount)
    return True


@bot.message_handler(content_types=["text"])
def on_text(message):
    if not message.from_user:
        return
    uid = message.from_user.id
    touch_username(uid, message.from_user.username)

    text = message.text.strip()
    parts = text.split()
    if not parts:
        return
    word = parts[0].lower().lstrip("/").rstrip(",.!?")
    if "@" in word:
        word = word.split("@", 1)[0]  # /start@Frogluda_bot -> start
    args = parts[1:]

    if uid in pending:
        handle_awaiting(message, word)
        return

    cmd = ALIASES.get(word)
    if cmd is None:
        return  # неизвестные сообщения игнорируем молча, без ответа и без записи в спам-лог

    warning = is_spam(uid)
    if warning:
        bot.reply_to(message, warning)
        return

    if cmd == "start":
        cmd_start(message)
    elif cmd == "balance":
        cmd_balance(message)
    elif cmd == "games":
        cmd_games(message)
    elif cmd == "top":
        cmd_top(message)
    elif cmd == "help":
        cmd_help(message)
    elif cmd == "daily":
        cmd_daily(message)
    elif cmd == "profile":
        cmd_profile(message)
    elif cmd == "transfer":
        cmd_transfer(message, args)
    elif cmd == "give":
        cmd_give(message, args)
    elif cmd in GAMES:
        begin_game(uid, message.chat.id, cmd, parse_amount(args[0]) if args else None)


