@bot.callback_query_handler(func=lambda call: call.data == "broadcast_start")
def cb_broadcast_start(call):
    user_id = call.from_user.id
    user = get_user(user_id)
    active = get_active_account(user_id)

    if not active:
        safe_edit_message("❌ Сначала добавьте аккаунт.", call.message.chat.id, call.message.message_id, reply_markup=back_keyboard())
        return

    account_id = active[0]
    text = user[1] or ""
    interval = user[2] or 1.0
    duration = user[8] if len(user) > 8 else 0
    mpc = user[9] if len(user) > 9 else 1
    mentions_mode = user[3] or 'none'
    mentions_count = user[4] or 10

    if not text.strip():
        safe_edit_message("❌ Сначала задайте текст сообщения в настройках.", call.message.chat.id, call.message.message_id, reply_markup=back_keyboard("broadcast_settings"))
        return

    selected = get_selected_chats(user_id, account_id)
    if not selected:
        safe_edit_message("❌ Сначала выберите чаты для рассылки.", call.message.chat.id, call.message.message_id, reply_markup=back_keyboard("select_chats"))
        return

    started = manager.start_client(account_id, active[2])
    if not started:
        safe_edit_message("❌ Не удалось подключить аккаунт.", call.message.chat.id, call.message.message_id, reply_markup=back_keyboard())
        return

    chat_ids = [s[0] for s in selected]

    db_query("UPDATE users SET is_running=1 WHERE user_id=?", (user_id,))

    dur_str = f"{duration} ч" if duration > 0 else "♾ Бесконечно"
    men_str = f"{mentions_count} чел" if mentions_mode != 'none' else "❌ Выключены"

    safe_edit_message(
        f"▶️ <b>Рассылка запущена!</b>\n\n"
        f"📝 Текст: {text[:50]}{'...' if len(text) > 50 else ''}\n"
        f"📋 Чатов: {len(chat_ids)}\n"
        f"📬 Сообщений на чат: {mpc}\n"
        f"⏱ Интервал: {interval} сек\n"
        f"⏳ Длительность: {dur_str}\n"
        f"👥 Упоминания: {men_str}",
        call.message.chat.id, call.message.message_id, reply_markup=stop_keyboard()
    )

    t = threading.Thread(target=broadcast_worker, args=(user_id, account_id, chat_ids, text + FOOTER_TEXT, interval, duration, mpc, mentions_mode, mentions_count), daemon=True)
    t.start()

