<script>
let accounts=[],aid=null,dialogs=[],peer=null,loginIdx=null;
const $=x=>document.getElementById(x);
const speedPresets={1:5,2:15,3:40};
function setWpm(){let n=Math.max(1,Number($('wpm').value)||1);$('delay').value=(60/n).toFixed(3)}
function setPreset(n){$('wpm').value=speedPresets[n];setWpm();toast('Скорость .m'+n+': '+speedPresets[n]+' слов/мин')}
$('delay').addEventListener('change',()=>{$('wpm').value=Math.max(1,Math.round(60/(Number($('delay').value)||0.3)))})
async function api(url,opt={}){let r=await fetch(url,{headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({detail:'Ошибка сервера'}));if(!r.ok)throw Error(d.detail||'Ошибка');return d}
function toast(t){const el=$('toast');if(!el)return;el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2800)}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function modal(s){$('dialog').innerHTML=s;$('modal').classList.add('open')}
function closeModal(){ $('modal').classList.remove('open') }
$('modal').addEventListener('click',e=>{if(e.target===$('modal'))closeModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
async function refresh(){try{let s=await api('/api/status');accounts=s.accounts;$('server').textContent='● Сервер подключён';if(!s.configured){$('list').innerHTML='<div class="empty">Откройте настройки и введите API ID и Hash.</div>';return}renderAccounts();if(aid===null&&accounts.length)chooseAccount(accounts[0].id)}catch(e){$('server').textContent='Сервер недоступен';$('list').innerHTML='<div class="empty">Запустите main.py в Pydroid.</div>'}}
function renderAccounts(){$('listTitle').textContent='Аккаунты';$('list').innerHTML=accounts.map(a=>`<div class="item ${a.id===aid?'active':''}" onclick="chooseAccount(${a.id})"><div class="avatar">${esc(a.name[0])}</div><div class="itemtext"><b>${esc(a.name)}</b><div class="preview">Аккаунт #${a.id}</div></div></div>`).join('')||'<div class="empty">Аккаунтов нет</div>'}
async function chooseAccount(id){document.querySelector('.layout').classList.remove('chat-open');aid=id;peer=null;renderAccounts();$('messages').innerHTML='<div class="empty">Загрузка диалогов…</div>';try{dialogs=await api(`/api/accounts/${id}/dialogs`);renderDialogs()}catch(e){toast(e.message)}}
function renderDialogs(){$('listTitle').textContent='Диалоги';$('list').innerHTML=dialogs.map(d=>`<div class="item ${d.id===peer?'active':''}" data-name="${esc(d.name.toLowerCase())}" onclick="choosePeer(${d.id},'${esc(d.name).replace(/'/g,"\\'")}')"><div class="avatar">${esc(d.name[0])}</div><div class="itemtext"><b>${esc(d.name)}</b><div class="preview">${esc(d.preview)}</div></div></div>`).join('')||'<div class="empty">Нет диалогов</div>'}
function filterList(){let q=$('search').value.toLowerCase();document.querySelectorAll('#list .item').forEach(x=>x.style.display=(x.dataset.name||'').includes(q)?'flex':'none')}
async function choosePeer(id,name){peer=id;document.querySelector('.layout').classList.add('chat-open');$('peerName').textContent=name;$('peerAvatar').innerHTML=`<img src="/api/accounts/${aid}/avatar/${peer}" onerror="this.remove();$('peerAvatar').textContent='${esc(name[0])}'">`;$('peerAvatar').onclick=()=>showProfile(peer);$('peerInfo').textContent='Аккаунт #'+aid;renderDialogs();await loadMessages()}
async function showProfile(userId){try{const p=await api(`/api/accounts/${aid}/profile/${userId}`);modal(`<div style="text-align:center;padding:12px"><img src="${p.avatar_url}" onerror="this.style.display='none'" style="width:92px;height:92px;object-fit:cover;border-radius:50%;background:var(--panel);margin-bottom:12px"><h2>${esc(p.name)}</h2>${p.username?`<div class="muted">@${esc(p.username)}</div>`:''}${p.is_bot?'<div class="muted">Бот</div>':''}${p.bio?`<p>${esc(p.bio)}</p>`:''}${p.phone?`<p>Телефон: ${esc(p.phone)}</p>`:''}<button onclick="closeModal()">Закрыть</button></div>`)}catch(e){toast(e.message)}}

/* FIX: update DOM only for new/changed messages; preserve current scroll position.
   The old implementation replaced all children and forced scrollTop=999999 every 5s. */
async function loadMessages(){
 if(aid===null||peer===null)return;
 const chat=$('messages');
 const nearBottom=chat.scrollHeight-chat.scrollTop-chat.clientHeight<80;
 const previousTop=chat.scrollTop;
 try{
  const ms=await api(`/api/accounts/${aid}/dialogs/${peer}/messages`);
  // Ignore stale responses if the user switched chats while the request was in flight.
  if(aid===null||peer===null)return;
  const expectedPeer=peer;
  const existing=new Map([...chat.querySelectorAll('.bubble[data-message-id]')].map(el=>[el.dataset.messageId,el]));
  for(const m of ms){
   const id=String(m.id);
   let el=existing.get(id);
   let media='';
   if(m.media_url&&m.media_kind==='image')media=`<img src="${m.media_url}" style="display:block;max-width:100%;max-height:280px;border-radius:12px;margin:6px 0" loading="lazy">`;
   else if(m.media_url&&m.media_kind==='video')media=`<video src="${m.media_url}" controls playsinline style="display:block;max-width:100%;max-height:280px;border-radius:12px;margin:6px 0"></video>`;
   else if(m.media_url&&m.media_kind==='sticker')media=`<video src="${m.media_url}" autoplay loop muted playsinline style="display:block;width:180px;max-width:100%;border-radius:12px;margin:6px 0"></video>`;
   else if(m.media_url)media=`<a href="${m.media_url}" target="_blank">📎 Открыть вложение</a>`;
   let quoted=m.reply_to?`<div style="border-left:3px solid var(--accent);padding:4px 7px;margin-bottom:6px;font-size:12px;opacity:.8">↪ ${esc(m.reply_preview||('Ответ на #'+m.reply_to))}</div>`:'';
   const senderLine=(!m.out&&m.sender&&String(m.sender.id)!==String(peer))?`<div class="senderline" style="display:flex;align-items:center;gap:6px;cursor:pointer" onclick="showProfile(${Number(m.sender.id)})"><img src="/api/accounts/${aid}/avatar/${Number(m.sender.id)}" onerror="this.style.display='none'" style="width:24px;height:24px;object-fit:cover;border-radius:50%;flex-shrink:0"><span>${esc(m.sender.name)}</span></div>`:'';
   const html=`${senderLine}${quoted}${esc(m.text)}${media}<div class="stamp">${m.date?new Date(m.date).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}):''} · #${m.id} <button onclick="setReply(${m.id},'${encodeURIComponent((m.text||m.reply_preview||'Медиа').slice(0,80))}')" style="margin-left:6px;padding:2px 7px;font-size:11px">Ответить</button></div>`;
   if(!el){
    el=document.createElement('div');
    el.className='bubble '+(m.out?'mine':'');
    el.dataset.messageId=id;
    el.innerHTML=html;
    chat.appendChild(el);
   }else{
    // Update only if content actually changed (e.g. edited message).
    if(el.innerHTML!==html)el.innerHTML=html;
    el.className='bubble '+(m.out?'mine':'');
   }
   existing.delete(id);
  }
  // Remove messages that are no longer in the server's latest 60-message window.
  for(const obsolete of existing.values())obsolete.remove();
  if(nearBottom)chat.scrollTop=chat.scrollHeight;
  else chat.scrollTop=previousTop;
  $('scrollDown')?.classList.toggle('visible',!nearBottom&&!!chat.querySelector('.bubble'));
 }catch(e){toast(e.message)}
}

function scrollToLatest(){const box=$('messages');box.scrollTo({top:box.scrollHeight,behavior:'smooth'});}
const messageBox=$('messages');
messageBox.addEventListener('scroll',()=>{
 const atBottom=messageBox.scrollHeight-messageBox.scrollTop-messageBox.clientHeight<90;
 $('scrollDown')?.classList.toggle('visible',!atBottom&&!!messageBox.querySelector('.bubble'));
});
function resizeComposer(){
 const field=$('msg');field.style.height='auto';
 field.style.height=Math.min(field.scrollHeight,field.parentElement.clientHeight*0.65,window.innerHeight*0.35)+'px';
}
$('msg').addEventListener('input',resizeComposer);
$('msg').addEventListener('focus',resizeComposer);
$('toolsGrip')?.addEventListener('click',()=> $('mobileTools')?.classList.toggle('collapsed'));
let toolsTouchStart=0;
$('toolsGrip')?.addEventListener('touchstart',e=>{toolsTouchStart=e.touches[0].clientY},{passive:true});
function resizeComposer(){const el=$('msg');if(!el)return;el.style.height='auto';el.style.height=Math.min(el.scrollHeight,window.innerHeight*0.35)+'px';el.style.overflowY=el.scrollHeight>window.innerHeight*0.35?'auto':'hidden'}
$('msg')?.addEventListener('input',resizeComposer);
$('toolsGrip')?.addEventListener('touchend',e=>{
 const delta=e.changedTouches[0].clientY-toolsTouchStart;
 if(Math.abs(delta)>25)$('mobileTools').classList.toggle('collapsed',delta>0);
});
function setReply(id,preview){preview=decodeURIComponent(preview);$('replyTo').value=id;$('replyLabel').textContent='Ответ на #'+id+' · '+preview;$('replyBanner').style.display='block';$('msg').focus()}
function clearReply(){$('replyTo').value='';$('replyBanner').style.display='none';$('replyLabel').textContent=''}
async function send(){let text=$('msg').value.trim();if(!text)return;if(aid===null||peer===null)return toast('Сначала выберите чат');try{
let reply=$('replyTo').value.trim(), rand=+$('randMax').value, words=+$('wordsPart').value||1;
let useQueue=$('autoChunk').checked||rand>0||text.split(/\\s+/).length>words;
if(useQueue){let r=await api(`/api/accounts/${aid}/dialogs/${peer}/queue`,{method:'POST',body:JSON.stringify({text,words_per_message:words,delay:Math.max(0.05,+$('delay').value||0.3),random_max:rand,reply_to:reply?+reply:null})});toast('Добавлено в очередь: '+r.parts+' частей');$('msg').value='';resizeComposer();clearReply();refreshQueue()}
else{await api(`/api/accounts/${aid}/dialogs/${peer}/send`,{method:'POST',body:JSON.stringify({text,reply_to:reply?+reply:null})});$('msg').value='';resizeComposer();clearReply();await loadMessages()}
}catch(e){toast(e.message)}}
async function queueAction(action){try{await api('/api/queue/'+action,{method:'POST'});refreshQueue()}catch(e){toast(e.message)}}
async function refreshQueue(){try{let q=await api('/api/queue');$('queueInfo').textContent=q.active?(q.paused?'⏸ Пауза':'▶ Отправка')+' · '+q.sent+'/'+q.total+' · в пути '+(q.pending||0)+' · осталось '+q.remaining+(q.last_error?' · '+q.last_error:''):(q.last_error||'Очередь не запущена')}catch(e){}}
async function toggleCaps(){try{let r=await api('/api/queue/caps',{method:'POST'});$('capsMode').checked=r.caps}catch(e){toast(e.message)}}
async function getPhoto(){if(aid===null||peer===null)return toast('Сначала выберите чат');try{let r=await api(`/api/accounts/${aid}/dialogs/${peer}/photo`,{method:'POST'});toast('Фото скачано: '+r.filename);window.open(r.url,'_blank')}catch(e){toast(e.message)}}
function pickTextFile(){$('filePicker').click()}
function readTextFile(el){let f=el.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{$('msg').value=String(r.result||'');toast('Текст загружен из '+f.name)};r.readAsText(f);el.value=''}
function addAccount(){modal(`<h3>Добавить Telegram</h3><p class="muted">Код придёт в официальный Telegram. Не передавайте его другим людям.</p><div class="field"><label>Номер телефона</label><input id="phone" placeholder="+7…"></div><div class="actions"><button onclick="closeModal()">Отмена</button><button class="primary" onclick="requestCode()">Получить код</button></div>`)}
async function requestCode(){try{let phone=$('phone').value.trim();let used=accounts.map(a=>a.id);loginIdx=Array.from({length:15},(_,i)=>i).find(i=>!used.includes(i));if(loginIdx===undefined)throw Error('Достигнут лимит в 15 аккаунтов');await api(`/api/accounts/${loginIdx}/request-code`,{method:'POST',body:JSON.stringify({phone})});modal(`<h3>Код подтверждения</h3><div class="field"><label>Код из Telegram</label><input id="code"></div><div class="actions"><button onclick="cancelLogin()">Отмена</button><button class="primary" onclick="signIn('${phone.replace(/'/g,"")}')">Войти</button></div>`)}catch(e){toast(e.message)}}
async function cancelLogin(){if(loginIdx!==null){try{await api(`/api/accounts/${loginIdx}/pending`,{method:'DELETE'})}catch(e){}}close();loginIdx=null}
async function signIn(phone){try{await api(`/api/accounts/${loginIdx}/sign-in`,{method:'POST',body:JSON.stringify({phone,code:$('code').value.trim()})});close();await refresh();toast('Аккаунт подключён')}catch(e){if(e.message.includes('пароль'))modal(`<h3>Пароль 2FA</h3><input id="pwd" type="password" placeholder="Пароль двухэтапной защиты"><div class="actions"><button onclick="closeModal()">Отмена</button><button class="primary" onclick="signPassword()">Продолжить</button></div>`);else toast(e.message)}}
async function signPassword(){try{await api(`/api/accounts/${loginIdx}/password`,{method:'POST',body:JSON.stringify({password:$('pwd').value})});close();await refresh()}catch(e){toast(e.message)}}
function settings(){modal(`<h3>Настройки API</h3><p class="muted">Получите собственные API ID и API Hash на my.telegram.org. Не используйте чужие ключи.</p><div class="field"><label>API ID</label><input id="apiid" type="number"></div><div class="field"><label>API Hash</label><input id="hash"></div><div class="actions"><button onclick="closeModal()">Закрыть</button><button class="primary" onclick="saveConfig()">Сохранить</button></div>`)}
async function saveConfig(){try{await api('/api/config',{method:'POST',body:JSON.stringify({api_id:+$('apiid').value,api_hash:$('hash').value})});close();await refresh();toast('Настройки сохранены')}catch(e){toast(e.message)}}
function accountManage(){modal(`<h3>Аккаунты</h3>${accounts.map(a=>`<div class="item"><div class="avatar">${esc(a.name[0])}</div><div style="flex:1">${esc(a.name)} <span class="muted">#${a.id}</span></div><button onclick="removeAccount(${a.id})">Отключить</button></div>`).join('')||'<p class="muted">Нет подключённых аккаунтов</p>'}<div class="field"><label>Импорт готовой Telegram-сессии (.session)</label><input id="sessionUpload" type="file" accept=".session" onchange="importSession(this)"></div><div class="actions"><button onclick="closeModal()">Закрыть</button><button onclick="closeModal();addAccount()">＋ Войти по номеру</button></div>`)}
async function importSession(el){const f=el.files&&el.files[0];if(!f)return;try{const fd=new FormData();fd.append('file',f);const r=await fetch('/api/accounts/import-session',{method:'POST',body:fd});const d=await r.json();if(!r.ok)throw Error(d.detail||'Ошибка импорта');close();await refresh();toast('Сессия импортирована: '+d.name+' (#'+d.id+')')}catch(e){toast(e.message)}finally{el.value=''}}
async function removeAccount(id){if(!confirm('Отключить аккаунт?'))return;try{await api('/api/accounts/'+id,{method:'DELETE'});aid=null;close();await refresh()}catch(e){toast(e.message)}}
function backToDialogs(){document.querySelector('.layout').classList.remove('chat-open');peer=null;renderDialogs()}
function nav(el,p){document.querySelectorAll('.nav').forEach(x=>x.classList.remove('active'));el.classList.add('active');if(p==='settings')settings();if(p==='accounts')accountManage()}
$('capsMode').addEventListener('change',toggleCaps);
// Persist the message controls locally so their values survive page reloads.
(function restoreAndPersistControls(){
 const ids=['wordsPart','delay','randMax','wpm','autoChunk','capsMode'];
 try{
  ids.forEach(id=>{
   const el=$(id); if(!el)return;
   const saved=localStorage.getItem('telegramDesk:'+id);
   if(saved!==null){
    if(el.type==='checkbox')el.checked=saved==='true';
    else el.value=saved;
   }
   const save=()=>localStorage.setItem('telegramDesk:'+id,el.type==='checkbox'?String(el.checked):el.value);
   el.addEventListener('change',save);
   el.addEventListener('input',save);
  });
 }catch(e){console.warn('Не удалось сохранить настройки в браузере',e)}
})();

refresh();setInterval(()=>{if(peer!==null)loadMessages();refreshQueue()},5000);
</script></body></html>"""

