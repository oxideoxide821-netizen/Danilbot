                    bot_instance.send_message(
                        chat_id,
                        "❌ Авторизация не удалась.",
                        reply_markup=main_menu_keyboard(False)
                    )

                await client.disconnect()

            try:
                loop.run_until_complete(do_auth())
            finally:
                try:
                    loop.run_until_complete(client.disconnect())
                except:
                    pass
            if user_id in self.pending:
                del self.pending[user_id]

        t = threading.Thread(target=auth_thread, daemon=True)
        t.start()

    def submit_password(self, user_id, password):
        if user_id in self.pending:
            self.pending[user_id]['password_value'] = password
            self.pending[user_id]['password_event'].set()
            return True
        return False

    def submit_email(self, user_id, code):
        if user_id in self.pending:
            self.pending[user_id]['email_value'] = code
            self.pending[user_id]['email_event'].set()
            return True
        return False

    def cancel(self, user_id):
        if user_id in self.pending:
            self.pending[user_id]['cancelled'] = True
            self.pending[user_id]['password_event'].set()
            self.pending[user_id]['email_event'].set()
            del self.pending[user_id]
            return True
        return False

