<aside><div class="head"><h3 id="listTitle">Диалоги</h3><input id="search" placeholder="Поиск…" oninput="filterList()"></div><div class="list" id="list"><div class="empty">Загрузка…</div></div><div style="padding:12px"><button class="primary" style="width:100%" onclick="addAccount()">＋ Аккаунт</button></div></aside>
<main><div class="chathead"><button class="backbtn" onclick="backToDialogs()" aria-label="Назад">←</button><div class="avatar" id="peerAvatar">T</div><div><b id="peerName">Выберите диалог</b><div class="muted" id="peerInfo" style="font-size:12px">Telegram Desk</div></div><div class="spacer"></div><button onclick="loadMessages()">↻</button></div><div class="chatbody" id="messages"><button id="scrollDown" title="Вниз" onclick="scrollToLatest()">↓</button><div class="empty">Добавьте аккаунт, чтобы начать.</div></div><div class="mobile-tools" id="mobileTools" style="padding:10px 13px;border-top:1px solid var(--line);display:flex;gap:8px;flex-wrap:wrap;align-items:center"><div class="tools-grip" id="toolsGrip" title="Свернуть / развернуть настройки"></div><div class="tools-grip" id="toolsGrip" title="Свернуть / развернуть настройки"></div>
<label class="muted">Слов/часть <input id="wordsPart" type="number" min="1" max="100" value="1" style="width:58px;padding:7px"></label>
<label class="muted">Задержка, сек <input id="delay" type="number" min="0.05" max="60" step="0.05" value="0.3" style="width:68px;padding:7px"></label>
<label class="muted">Rand max <input id="randMax" type="number" min="0" max="20" value="0" style="width:58px;padding:7px"></label>
<span class="muted">Скорость:</span><button type="button" onclick="setPreset(1)">.m1 · 5</button><button type="button" onclick="setPreset(2)">.m2 · 15</button><button type="button" onclick="setPreset(3)">.m3 · 40</button>
<label class="muted">Сл/мин <input id="wpm" type="number" min="1" max="1200" value="200" style="width:68px;padding:7px" onchange="setWpm()"></label>
<label class="muted">Ответ # <input id="replyTo" type="number" placeholder="—" style="width:75px;padding:7px"></label>
<label class="muted"><input id="autoChunk" type="checkbox" checked style="width:auto"> Очередь частями</label>
<label class="muted"><input id="capsMode" type="checkbox" style="width:auto"> CAPS</label>
<button onclick="pickTextFile()">Файл .txt</button><button onclick="getPhoto()">Скачать фото</button>
</div>
