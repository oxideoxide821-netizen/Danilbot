        await p["client"].disconnect()
    return {"ok": True}

@app.post("/api/accounts/{idx}/sign-in")
async def sign_in(idx: int, data: Code):
    p = pending.get(idx)
    if not p:
        raise HTTPException(400, "Сначала запросите код.")
    if data.phone.strip() != p["phone"]:
        raise HTTPException(400, "Номер телефона не совпадает.")
    try:
        await p["client"].sign_in(phone=p["phone"], code=data.code.strip(), phone_code_hash=p["hash"])
        me = await p["client"].get_me()
        accounts[idx] = {"client": p["client"], "name": name_of(me)}
        pending.pop(idx, None)
        return {"ok": True, "name": accounts[idx]["name"]}
    except SessionPasswordNeededError:
        raise HTTPException(428, "Нужен пароль двухэтапной аутентификации.")
    except Exception as e:
        raise HTTPException(400, str(e))

