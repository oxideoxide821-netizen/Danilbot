# ================== DATABASE ==================
def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            session_string TEXT,
            auth_step TEXT DEFAULT 'none',
            broadcast_text TEXT DEFAULT '',
            broadcast_interval REAL DEFAULT 1.0,
            broadcast_mentions INTEGER DEFAULT 0,
            is_running INTEGER DEFAULT 0,
            send_mode TEXT DEFAULT 'all'
        )
    """)
    try:
        c.execute("ALTER TABLE users ADD COLUMN send_mode TEXT DEFAULT 'all'")
    except sqlite3.OperationalError:
        pass
    c.execute("""
        CREATE TABLE IF NOT EXISTS selected_chats (
            user_id INTEGER,
            chat_id INTEGER,
            chat_name TEXT,
            PRIMARY KEY (user_id, chat_id)
        )
    """)
    conn.commit()
    conn.close()

def db_query(query, params=(), fetchone=False):
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute(query, params)
    conn.commit()
    result = c.fetchone() if fetchone else c.fetchall()
    conn.close()
    return result

# ================== TELETHON MANAGER ==================
class TelethonManager:
    def __init__(self):
        self.clients = {}
        self.loops = {}
        self.threads = {}

    def _start_loop(self, user_id, session_string):
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        client = TelegramClient(StringSession(session_string), API_ID, API_HASH, loop=loop)
        loop.run_until_complete(client.connect())
        self.clients[user_id] = client
        self.loops[user_id] = loop
        loop.run_forever()

    def start_client(self, user_id, session_string=None):
        if user_id in self.threads and self.threads[user_id].is_alive():
            return True
        t = threading.Thread(target=self._start_loop, args=(user_id, session_string), daemon=True)
        t.start()
        self.threads[user_id] = t
        for _ in range(50):
            if user_id in self.clients:
                return True
            time.sleep(0.1)
        return False

    def get_client(self, user_id):
        return self.clients.get(user_id)

    def run_sync(self, user_id, coro, timeout=30):
        loop = self.loops.get(user_id)
        if not loop:
            return None
        future = asyncio.run_coroutine_threadsafe(coro, loop)
        try:
            return future.result(timeout=timeout)
        except Exception as e:
            raise e

    def disconnect(self, user_id):
        if user_id in self.clients:
            try:
                self.run_sync(user_id, self.clients[user_id].disconnect(), timeout=10)
            except:
                pass
            del self.clients[user_id]
        if user_id in self.loops:
            try:
                self.loops[user_id].stop()
            except:
                pass
            del self.loops[user_id]

