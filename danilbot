# ================== DATABASE ==================
def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False, timeout=30.0)
    c = conn.cursor()
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA synchronous=NORMAL")
    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            broadcast_text TEXT DEFAULT '',
            broadcast_interval REAL DEFAULT 1.0,
            mentions_mode TEXT DEFAULT 'none',
            mentions_count INTEGER DEFAULT 10,
            send_mode TEXT DEFAULT 'all',
            is_running INTEGER DEFAULT 0,
            active_account_id INTEGER DEFAULT NULL,
            broadcast_duration_hours REAL DEFAULT 0,
            messages_per_chat INTEGER DEFAULT 1
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            session_path TEXT,
            phone TEXT,
            first_name TEXT,
            last_name TEXT,
            created_at INTEGER DEFAULT 0
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS selected_chats (
            user_id INTEGER,
            account_id INTEGER,
            chat_id INTEGER,
            chat_name TEXT,
            PRIMARY KEY (user_id, account_id, chat_id)
        )
    """)
    conn.commit()
    conn.close()

def db_query(query, params=(), fetchone=False):
    with _db_lock:
        conn = sqlite3.connect(DB_PATH, check_same_thread=False, timeout=30.0)
        try:
            c = conn.cursor()
            c.execute(query, params)
            conn.commit()
            result = c.fetchone() if fetchone else c.fetchall()
            return result
        finally:
            conn.close()

# ================== TELETHON MANAGER ==================
class TelethonManager:
    def __init__(self):
        self.clients = {}
        self.loops = {}
        self.threads = {}
        self.dialogs_cache = {}
        self.dialogs_cache_ttl = 300

    def _session_path(self, account_id):
        return os.path.join(SESSIONS_DIR, f"account_{account_id}.session")

    def _start_loop(self, account_id, session_path):
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        session = SQLiteSession(session_path)
        client = TelegramClient(session, API_ID, API_HASH, loop=loop)
        loop.run_until_complete(client.connect())
        self.clients[account_id] = client
        self.loops[account_id] = loop
        loop.run_forever()

    def start_client(self, account_id, session_path=None):
        client = self.clients.get(account_id)
        if client:
            try:
                authorized = self.run_sync(account_id, client.is_user_authorized(), timeout=15)
                if authorized:
                    return True
            except Exception:
                pass
            self.disconnect(account_id)
        if account_id in self.threads and self.threads[account_id].is_alive():
            self.disconnect(account_id)
        if session_path is None:
            session_path = self._session_path(account_id)
        t = threading.Thread(target=self._start_loop, args=(account_id, session_path), daemon=True)
        t.start()
        self.threads[account_id] = t
        for _ in range(50):
            if account_id in self.clients:
                try:
                    auth = self.run_sync(account_id, self.clients[account_id].is_user_authorized(), timeout=15)
                    if auth:
                        return True
                except:
                    pass
            time.sleep(0.1)
        return False

    def get_client(self, account_id):
        client = self.clients.get(account_id)
        if not client:
            return None
        try:
            authorized = self.run_sync(account_id, client.is_user_authorized(), timeout=10)
            if authorized:
                return client
        except Exception:
            pass
        self.disconnect(account_id)
        return None

    def run_sync(self, account_id, coro, timeout=30):
        loop = self.loops.get(account_id)
        if not loop:
            return None
        future = asyncio.run_coroutine_threadsafe(coro, loop)
        try:
            return future.result(timeout=timeout)
        except Exception as e:
            raise e

    def disconnect(self, account_id):
        if account_id in self.clients:
            try:
                self.run_sync(account_id, self.clients[account_id].disconnect(), timeout=10)
            except:
                pass
            del self.clients[account_id]
        if account_id in self.loops:
            try:
                self.loops[account_id].stop()
            except:
                pass
            del self.loops[account_id]
        self.dialogs_cache.pop(account_id, None)

    def get_dialogs_cached(self, account_id, client, me_id, force_refresh=False):
        now = time.time()
        if not force_refresh and account_id in self.dialogs_cache:
            ts, dialogs = self.dialogs_cache[account_id]
            if now - ts < self.dialogs_cache_ttl:
                return dialogs
        dialogs = self.run_sync(account_id, fetch_all_group_dialogs(client, me_id), timeout=600)
        self.dialogs_cache[account_id] = (now, dialogs)
        return dialogs

    def invalidate_dialogs_cache(self, account_id):
        self.dialogs_cache.pop(account_id, None)

