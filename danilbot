@bot.callback_query_handler(func=lambda call: call.data == "auth_cancel")
def cb_auth_cancel(call):
    user_id = call.from_user.id
    
    # Если админ вводил цену/страну/номер/код/2фа
    if user_states.get(user_id) in ('waiting_price', 'waiting_country', 'admin_phone_input', 'admin_code_input', 'admin_2fa_input'):
        user_states.pop(f'{user_id}_temp_session', None)
        user_states.pop(f'{user_id}_temp_phone', None)
        user_states.pop(f'{user_id}_temp_price', None)
        user_states.pop(user_id, None)
        phone_auth_manager.cancel(user_id)
        qr_manager.cancel(user_id)
        bot.answer_callback_query(call.id, "Отменено")
        try:
            bot.edit_message_text("❌ Добавление отменено.", chat_id=call.message.chat.id, message_id=call.message.message_id, reply_markup=admin_menu_keyboard())
        except:
            bot.send_message(call.message.chat.id, "❌ Добавление отменено.", reply_markup=admin_menu_keyboard())
        return
    
    cancelled = False
    if qr_manager.cancel(user_id):
        cancelled = True
    if phone_auth_manager.cancel(user_id):
        cancelled = True
    
    if cancelled:
        bot.answer_callback_query(call.id, "Отменено")
        user_states.pop(user_id, None)
        kb = admin_menu_keyboard() if is_admin(user_id) else main_menu_keyboard()
        try:
            bot.edit_message_text("❌ Отменено.", chat_id=call.message.chat.id, message_id=call.message.message_id, reply_markup=kb)
        except:
            bot.send_message(call.message.chat.id, "❌ Отменено.", reply_markup=kb)
    else:
        bot.answer_callback_query(call.id, "Нет активной операции.")

