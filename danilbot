            bot.send_message(user_id, "❌ Ошибка.")
    elif pending.get('password_value') is None:
        if qr_manager.submit_password(user_id, text):
            bot.send_message(user_id, "⏳ Проверка пароля...")
        else:
            bot.send_message(user_id, "❌ Ошибка.")
    else:
        bot.send_message(user_id, "⏳ Проверяется...")

