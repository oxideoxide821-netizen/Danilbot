    state = pending.pop(uid, None)
    if not state:
        return
    bet = state["bet"]
    result = random.choice(["орел", "решка"])
    gross = int(bet * 1.9) if result == side else 0
    finish(chat_id, uid, bet, gross, "Выпала {}.".format(result), "coin")


def settle_dice(uid, chat_id, bet, guess):
    rolling.add(uid)
    msg = bot.send_dice(chat_id)
    value = msg.dice.value

    def finish_later():
        try:
            if guess in ("чет", "нечет"):
                ok = (value % 2 == 0) == (guess == "чет")
            else:
                ok = (value <= 3) == (guess == "мало")
            finish(chat_id, uid, bet, bet * 2 if ok else 0, "Выпало {}.".format(value), "dice")
        finally:
            rolling.discard(uid)

    threading.Timer(4.0, finish_later).start()


def spin_roulette(uid, chat_id, bet, choice):
    number = random.randint(0, 36)
    if number == 0:
        color = "зеро"
    elif number in ROULETTE_REDS:
        color = "красное"
    else:
        color = "чёрное"

    gross = 0
    if choice == "red" and color == "красное":
        gross = bet * 2
    elif choice == "black" and color == "чёрное":
        gross = bet * 2
    elif choice == "d1" and 1 <= number <= 12:
        gross = bet * 3
    elif choice == "d2" and 13 <= number <= 24:
        gross = bet * 3
    elif choice == "d3" and 25 <= number <= 36:
        gross = bet * 3
    elif choice == "green" and number == 0:
        gross = bet * 36
    elif choice.startswith("num:") and int(choice[4:]) == number:
        gross = bet * 36
    finish(chat_id, uid, bet, gross, "Выпало {} ({}).".format(number, color), "roulette")


def settle_guess(uid, chat_id, number):
    state = pending.pop(uid, None)
    if not state:
        return
    bet = state["bet"]
    secret = random.randint(1, 10)
    gross = bet * 9 if secret == number else 0
    finish(chat_id, uid, bet, gross, "Загадано {}, вы указали {}.".format(secret, number), "guess")


# ---------- 21 очко ----------

def draw_card():
    return random.choice([2, 3, 4, 5, 6, 7, 8, 9, 10, 10, 10, 10, 11])


def hand_value(cards):
    total = sum(cards)
    aces = cards.count(11)
    while total > 21 and aces:
        total -= 10
        aces -= 1
    return total


def bj_text(s):
    return "Ваши карты: {} ({})\nКарта дилера: {}".format(
        hand_value(s["player"]), ", ".join(map(str, s["player"])), s["dealer"][0])


def start_bj(uid, chat_id, bet):
    player = [draw_card(), draw_card()]
    dealer = [draw_card()]
    if hand_value(player) == 21:
        finish(chat_id, uid, bet, int(bet * 2.5), "21 с раздачи!", "bj")
        return
    state = {"player": player, "dealer": dealer, "bet": bet, "chat": chat_id}
    bj_games[uid] = state
    msg = bot.send_message(chat_id, bj_text(state), reply_markup=bj_kb(can_double=True))
    state["msg"] = msg.message_id


def bj_bust(uid, s):
    bj_games.pop(uid, None)
    net, lines = settle(uid, s["bet"], 0)
    head = "Ваши карты: {} ({})\nПеребор.".format(hand_value(s["player"]), ", ".join(map(str, s["player"])))
    safe_edit(s["chat"], s["msg"], compose(head, net, lines),
              reply_markup=again_keyboard("bj", s["bet"] // (2 if s.get("doubled") else 1)))


def bj_hit(uid):
    s = bj_games.get(uid)
    if not s:
        return
    s["player"].append(draw_card())
    if hand_value(s["player"]) > 21:
        bj_bust(uid, s)
    else:
        safe_edit(s["chat"], s["msg"], bj_text(s), reply_markup=bj_kb())


def bj_double(uid, chat_id):
    s = bj_games.get(uid)
    if not s or len(s["player"]) != 2:
        return
    if not try_charge(uid, s["bet"]):
        bot.send_message(chat_id, "Недостаточно средств для удвоения.")
        return
    s["bet"] *= 2
    s["doubled"] = True
    s["player"].append(draw_card())
    if hand_value(s["player"]) > 21:
        bj_bust(uid, s)
    else:
        safe_edit(s["chat"], s["msg"], bj_text(s) + "\nСтавка удвоена.")
        bj_stand(uid)


def bj_stand(uid):
    s = bj_games.pop(uid, None)
    if not s:
        return
    dealer = s["dealer"]
    while hand_value(dealer) < 17:
        dealer.append(draw_card())
    pv, dv = hand_value(s["player"]), hand_value(dealer)
    bet = s["bet"]
    head = "У вас {} ({}), у дилера {} ({}).".format(
        pv, ", ".join(map(str, s["player"])), dv, ", ".join(map(str, dealer)))
    if dv > 21:
        gross, head = bet * 2, head + "\nДилер перебрал."
    elif pv > dv:
        gross, head = bet * 2, head + "\nВаша победа."
    elif pv == dv:
        gross, head = bet, head + "\nНичья."
    else:
        gross, head = 0, head + "\nПобеда дилера."
    base = bet // 2 if s.get("doubled") else bet
    finish(s["chat"], uid, bet, gross, head, "bj" if base == bet else "bj")


# ---------- Краш ----------

def launch_crash(uid, chat_id, bet):
    crash_point = max(1.01, round(RTP / (1.0 - random.random()), 2))
    msg = bot.send_message(chat_id, "Раунд запущен.\nМножитель: х1.00", reply_markup=cashout_kb())
    crash_rounds[uid] = {"bet": bet, "mult": 1.0, "crash": crash_point,
                         "chat": chat_id, "msg": msg.message_id, "active": True}
    threading.Thread(target=crash_loop, args=(uid,), daemon=True).start()


def crash_loop(uid):
    while True:
        time.sleep(1)
        with crash_lock:
            r = crash_rounds.get(uid)
            if not r or not r["active"]:
                return
            r["mult"] = round(r["mult"] * (1.07 + random.random() * 0.07) + 0.01, 2)
            crashed = r["mult"] >= r["crash"]
            if crashed:
                r["active"] = False
            mult = r["mult"]
        if crashed:
            net, lines = settle(uid, r["bet"], 0)
            safe_edit(r["chat"], r["msg"], compose("Краш на х{}.".format(fmt_mult(r["crash"])), net, lines),
                      reply_markup=again_keyboard("crash", r["bet"]))
            return
        safe_edit(r["chat"], r["msg"],
                  "Раунд идёт.\nМножитель: х{}\nМожно забрать: {}".format(fmt_mult(mult), fmt(int(r["bet"] * mult))),
                  reply_markup=cashout_kb())


def crash_cashout(uid, chat_id):
    with crash_lock:
        r = crash_rounds.get(uid)
        if not r or not r["active"]:
            return
        r["active"] = False
        mult = r["mult"]
    net, lines = settle(uid, r["bet"], int(r["bet"] * mult))
    safe_edit(chat_id, r["msg"], compose("Вы забрали выигрыш на х{}.".format(fmt_mult(mult)), net, lines),
              reply_markup=again_keyboard("crash", r["bet"]))


