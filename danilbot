@bot.callback_query_handler(func=lambda c: c.data.startswith('mpage_'))
def cb_mpage(c):
    bot.answer_callback_query(c.id)
    page = int(c.data.split('_')[1])
    per_page = 5
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT id, seller_name, title, price, category FROM items WHERE status='approved' ORDER BY id DESC")
    items = cur.fetchall()
    conn.close()
    
    if not items:
        kb = InlineKeyboardMarkup()
        kb.row(InlineKeyboardButton("💰 Выставить товар", callback_data="sell_start"))
        kb.row(InlineKeyboardButton("🔙 Назад", callback_data="market"))
        bot.edit_message_text("😕 Пока нет товаров. Будь первым!", c.message.chat.id, c.message.message_id, reply_markup=kb)
        return
    
    total = max(1, (len(items)+per_page-1)//per_page)
    page = max(0, min(page, total-1))
    start = page*per_page
    page_items = items[start:start+per_page]
    
    txt = f"🛍 <b>Товары</b> (стр. {page+1}/{total})\n\n"
    kb = InlineKeyboardMarkup()
    for it in page_items:
        iid, seller, title, price, cat = it
        cat_name = CATEGORIES.get(cat, cat)
        txt += f"📦 <b>{title}</b>\n   💵 {price} руб. | {cat_name}\n   👤 @{seller}\n\n"
        kb.row(InlineKeyboardButton(f"Купить: {title[:25]}", callback_data=f"item_{iid}_{page}"))
    
    nav = []
    if page > 0: nav.append(InlineKeyboardButton("⬅️", callback_data=f"mpage_{page-1}"))
    if page < total-1: nav.append(InlineKeyboardButton("➡️", callback_data=f"mpage_{page+1}"))
    if nav: kb.row(*nav)
    kb.row(InlineKeyboardButton("🏠 Меню", callback_data="main"))
    bot.edit_message_text(txt, c.message.chat.id, c.message.message_id, reply_markup=kb)

