# ---------- 21 очко ----------

def draw_card():
    return random.choice([2, 3, 4, 5, 6, 7, 8, 9, 10, 10, 10, 10, 11])


def hand_value(cards):
    total = sum(cards)
    aces = cards.count(11)
    while total > 21 and aces:
        total -= 10
        aces -= 1
    return total


def bj_text(s):
    return ("Ваши карты: {} ({})\n"
            "Карта дилера: {}".format(hand_value(s["player"]), ", ".join(map(str, s["player"])),
                                      s["dealer"][0]))


def start_bj(uid, chat_id, bet):
    player = [draw_card(), draw_card()]
    dealer = [draw_card()]
    if hand_value(player) == 21:
        total = int(bet * 2.5)
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(chat_id, "21 с раздачи. Выплата: +{}".format(fmt(total)), "bj", bet)
        return
    state = {"player": player, "dealer": dealer, "bet": bet, "chat": chat_id}
    bj_games[uid] = state
    msg = bot.send_message(chat_id, bj_text(state), reply_markup=bj_kb())
    state["msg"] = msg.message_id


def bj_hit(uid):
    s = bj_games.get(uid)
    if not s:
        return
    s["player"].append(draw_card())
    value = hand_value(s["player"])
    if value > 21:
        add_stats(uid, False, 0)
        safe_edit(s["chat"], s["msg"],
                  "Ваши карты: {} ({})\nПеребор. Итог: -{}".format(value, ", ".join(map(str, s["player"])), fmt(s["bet"])),
                  reply_markup=again_keyboard("bj", s["bet"]))
        bj_games.pop(uid, None)
    else:
        safe_edit(s["chat"], s["msg"], bj_text(s), reply_markup=bj_kb())


def bj_stand(uid):
    s = bj_games.pop(uid, None)
    if not s:
        return
    dealer = s["dealer"]
    while hand_value(dealer) < 17:
        dealer.append(draw_card())
    pv, dv = hand_value(s["player"]), hand_value(dealer)
    bet = s["bet"]

    header = "У вас {} ({}), у дилера {} ({}).\n".format(pv, ", ".join(map(str, s["player"])),
                                                          dv, ", ".join(map(str, dealer)))
    if dv > 21:
        total = bet * 2
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(s["chat"], header + "Дилер перебрал. Выигрыш: +{}".format(fmt(total)), "bj", bet)
    elif pv > dv:
        total = bet * 2
        add_balance(uid, total)
        add_stats(uid, True, total - bet)
        send_result(s["chat"], header + "Ваша победа: +{}".format(fmt(total)), "bj", bet)
    elif pv == dv:
        add_balance(uid, bet)
        send_result(s["chat"], header + "Ничья. Ставка возвращена.", "bj", bet)
    else:
        add_stats(uid, False, 0)
        send_result(s["chat"], header + "Победа дилера. Итог: -{}".format(fmt(bet)), "bj", bet)


# ---------- Краш ----------

def launch_crash(uid, chat_id, bet):
    crash_point = max(1.01, round(0.99 / (1.0 - random.random()), 2))
    msg = bot.send_message(chat_id, "Раунд запущен.\nМножитель: х1.00", reply_markup=cashout_kb())
    crash_rounds[uid] = {"bet": bet, "mult": 1.0, "crash": crash_point,
                         "chat": chat_id, "msg": msg.message_id, "active": True}
    threading.Thread(target=crash_loop, args=(uid,), daemon=True).start()


def crash_loop(uid):
    while True:
        time.sleep(1)
        r = crash_rounds.get(uid)
        if not r or not r["active"]:
            return
        r["mult"] = round(r["mult"] + 0.12 + random.random() * 0.12, 2)
        if r["mult"] >= r["crash"]:
            r["active"] = False
            add_stats(uid, False, 0)
            safe_edit(r["chat"], r["msg"],
                      "Краш на х{}.\nСтавка проиграна: -{}".format(r["crash"], fmt(r["bet"])),
                      reply_markup=again_keyboard("crash", r["bet"]))
            return
        safe_edit(r["chat"], r["msg"],
                  "Раунд идёт.\nМножитель: х{}".format(r["mult"]),
                  reply_markup=cashout_kb())


def crash_cashout(uid, chat_id):
    r = crash_rounds.get(uid)
    if not r or not r["active"]:
        return
    r["active"] = False
    total = int(r["bet"] * r["mult"])
    add_balance(uid, total)
    add_stats(uid, True, total - r["bet"])
    safe_edit(chat_id, r["msg"],
              "Вы забрали выигрыш на х{}.\nИтог: +{}".format(r["mult"], fmt(total)),
              reply_markup=again_keyboard("crash", r["bet"]))


