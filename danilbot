def handle_awaiting(message, word, state):
    uid = message.from_user.id
    if state.get("await") == "num":
        number = parse_amount(word)
        if number is None or not (0 <= number <= 36):
            bot.reply_to(message, "Введите число от 0 до 36 (или «отмена»).")
            return
        pending.pop(uid, None)
        spin_roulette(uid, message.chat.id, state["bet"], "num:{}".format(number))
        return
    amount = parse_amount(word)  # своя ставка
    if amount is None:
        bot.reply_to(message, "Введите сумму числом, например: 500 или 2к (или «отмена»).")
        return
    pending.pop(uid, None)
    begin_game(uid, message.chat.id, state["game"], amount)


@bot.message_handler(content_types=["text"])
def on_text(message):
    if not message.from_user:
        return
    uid = message.from_user.id
    touch_username(uid, message.from_user.username)

    parts = message.text.strip().split()
    if not parts:
        return
    word = parts[0].lower().lstrip("/").rstrip(",.!?")
    if "@" in word:
        word = word.split("@", 1)[0]
    args = parts[1:]

    expire_pending(uid)
    state = pending.get(uid)
    if state:
        if word in CANCEL_WORDS:
            pending.pop(uid, None)
            if state.get("paid"):
                add_balance(uid, state["bet"])
                bot.reply_to(message, "Действие отменено, ставка возвращена.")
            else:
                bot.reply_to(message, "Действие отменено.")
            return
        if state.get("await") in ("bet", "num"):
            handle_awaiting(message, word, state)
            return

    cmd = ALIASES.get(word)
    if cmd is None:
        return

    warning = is_spam(uid)
    if warning:
        bot.reply_to(message, warning)
        return

    if cmd == "start":
        cmd_start(message)
    elif cmd == "balance":
        cmd_balance(message)
    elif cmd == "games":
        cmd_games(message)
    elif cmd == "top":
        cmd_top(message)
    elif cmd == "help":
        cmd_help(message)
    elif cmd == "daily":
        cmd_daily(message)
    elif cmd == "profile":
        cmd_profile(message)
    elif cmd == "jackpot":
        cmd_jackpot(message)
    elif cmd == "rescue":
        cmd_rescue(message)
    elif cmd == "transfer":
        cmd_transfer(message, args)
    elif cmd == "give":
        cmd_give(message, args)
    elif cmd in GAMES:
        begin_game(uid, message.chat.id, cmd, parse_amount(args[0]) if args else None)


