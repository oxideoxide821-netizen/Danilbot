def cb_mentions(call):
    try: bot.answer_callback_query(call.id)
    except: pass
    user_id = call.from_user.id
    show_mentions_settings(call.message.chat.id, call.message.message_id, user_id)

@bot.callback_query_handler(func=lambda call: call.data.startswith("set_mention:"))
def cb_set_mention(call):
    user_id = call.from_user.id
    mode = call.data.split(":", 1)[1]
    db_query("UPDATE users SET mentions_mode=? WHERE user_id=?", (mode, user_id))
    try: bot.answer_callback_query(call.id, f"Режим: {mode}")
    except: pass
    show_mentions_settings(call.message.chat.id, call.message.message_id, user_id)

@bot.callback_query_handler(func=lambda call: call.data == "set_mentions_count")
def cb_set_mentions_count(call):
    try: bot.answer_callback_query(call.id)
    except: pass
    user_id = call.from_user.id
    user_states[user_id] = "waiting_mentions_count"
    safe_edit_message_text("🔢 <b>Количество упоминаемых</b>\n\nВведите число от 1 до 200:", chat_id=call.message.chat.id, message_id=call.message.message_id, reply_markup=back_keyboard("mentions_settings"))

@bot.message_handler(func=lambda m: user_states.get(m.from_user.id) == "waiting_mentions_count")
def handle_mentions_count(message):
    user_id = message.from_user.id
    try:
        count = int(message.text.strip())
        if count < 1 or count > 200:
            raise ValueError
        db_query("UPDATE users SET mentions_count=? WHERE user_id=?", (count, user_id))
        user_states.pop(user_id, None)
        bot.send_message(user_id, f"✅ Количество установлено: {count}", reply_markup=back_keyboard("mentions_settings"))
    except:
        bot.send_message(user_id, "❌ Введите число от 1 до 200.")

# ---------- CHAT SELECTION ----------
@bot.callback_query_handler(func=lambda call: call.data == "select_chats")
def cb_select_chats(call):
    user_id = call.from_user.id
    if not has_accounts(user_id):
        try: bot.answer_callback_query(call.id, "❌ Сначала добавьте аккаунт!")
        except: pass
        return
    acc = get_active_account(user_id)
    if not acc:
        try: bot.answer_callback_query(call.id, "❌ Выберите активный аккаунт!")
        except: pass
        return
    try: bot.answer_callback_query(call.id, "⏳ Загрузка чатов...")
    except: pass
    show_chat_selection(call.message.chat.id, call.message.message_id, user_id, page=0)

@bot.callback_query_handler(func=lambda call: call.data.startswith("tc:"))
def cb_toggle_chat(call):
    user_id = call.from_user.id
    parts = call.data.split(":")
    chat_id_int = int(parts[1])
    page = int(parts[2])
    acc = get_active_account(user_id)
    if not acc:
        bot.answer_callback_query(call.id, "❌ Нет активного аккаунта!")
        return
    account_id = acc[0]
    name = "Чат"
    try:
        client = manager.get_client(account_id)
        if client:
            me = manager.run_sync(account_id, client.get_me(), timeout=10)
            dialogs = manager.get_dialogs_cached(account_id, client, me.id)
            for d in dialogs:
                if d.id == chat_id_int:
                    name = (d.name or "Без названия").replace(":", " ")[:25]
                    break
    except:
        pass
    is_now_selected = toggle_chat_selection(user_id, account_id, chat_id_int, name)
    status = "добавлен" if is_now_selected else "убран"
    try: bot.answer_callback_query(call.id, f"Чат {status}!")
    except: pass
    show_chat_selection(call.message.chat.id, call.message.message_id, user_id, page=page)

@bot.callback_query_handler(func=lambda call: call.data.startswith("chat_page:"))
def cb_chat_page(call):
    try: bot.answer_callback_query(call.id, "⏳ Загрузка...")
    except: pass
    user_id = call.from_user.id
    _, page = call.data.split(":")
    show_chat_selection(call.message.chat.id, call.message.message_id, user_id, page=int(page))

@bot.callback_query_handler(func=lambda call: call.data == "refresh_chats")
def cb_refresh_chats(call):
    try: bot.answer_callback_query(call.id, "🔄 Обновляем...")
    except: pass
    acc = get_active_account(call.from_user.id)
    if acc:
        manager.invalidate_dialogs_cache(acc[0])
    show_chat_selection(call.message.chat.id, call.message.message_id, call.from_user.id, page=0, force_refresh=True)

@bot.callback_query_handler(func=lambda call: call.data == "chat_filter")
def cb_chat_filter(call):
    try: bot.answer_callback_query(call.id)
    except: pass
    user_id = call.from_user.id
    user_states[user_id] = "waiting_chat_filter"
    safe_edit_message_text("🔍 <b>Фильтр по названию</b>\n\nВведите часть названия чата:", chat_id=call.message.chat.id, message_id=call.message.message_id, reply_markup=back_keyboard("select_chats"))

@bot.message_handler(func=lambda m: user_states.get(m.from_user.id) == "waiting_chat_filter")
def handle_chat_filter(message):
    user_id = message.from_user.id
    chat_filters[user_id] = message.text.strip()
    user_states.pop(user_id, None)
    bot.send_message(user_id, f"✅ Фильтр: <code>{chat_filters[user_id]}</code>", reply_markup=back_keyboard("select_chats"))

@bot.callback_query_handler(func=lambda call: call.data == "chat_filter_reset")
def cb_chat_filter_reset(call):
    try: bot.answer_callback_query(call.id, "Фильтр сброшен")
    except: pass
    chat_filters.pop(call.from_user.id, None)
    show_chat_selection(call.message.chat.id, call.message.message_id, call.from_user.id, page=0)

@bot.callback_query_handler(func=lambda call: call.data == "toggle_send_mode")
def cb_toggle_send_mode(call):
    user_id = call.from_user.id
    user = get_user(user_id)
    current = user[5] if len(user) > 5 else 'all'
    new_mode = 'selected' if current == 'all' else 'all'
    db_query("UPDATE users SET send_mode=? WHERE user_id=?", (new_mode, user_id))
    acc = get_active_account(user_id)
    if new_mode == 'all' and acc:
        clear_selected_chats(user_id, acc[0])
        try: bot.answer_callback_query(call.id, "Режим: ВСЕ чаты. Выбор сброшен.")
        except: pass
    else:
        try: bot.answer_callback_query(call.id, "Режим: ВЫБРАННЫЕ чаты.")
        except: pass
    show_chat_selection(call.message.chat.id, call.message.message_id, user_id, page=0)

# ---------- BROADCAST START ----------
@bot.callback_query_handler(func=lambda call: call.data == "broadcast_start")
def cb_broadcast_start(call):
    user_id = call.from_user.id
    user = get_user(user_id)
    text = user[1]
    interval = user[2] or 1.0
    mentions_mode = user[3] if len(user) > 3 else 'none'
    mentions_count = user[4] if len(user) > 4 else 10
    send_mode = user[5] if len(user) > 5 else 'all'

    if not text:
        try: bot.answer_callback_query(call.id, "❌ Сначала задайте текст!")
        except: pass
        return
    if user[6]:
        try: bot.answer_callback_query(call.id, "⚠️ Уже выполняется!")
        except: pass
        return
    acc = get_active_account(user_id)
    if not acc:
        try: bot.answer_callback_query(call.id, "❌ Нет активного аккаунта!")
        except: pass
        return
    account_id = acc[0]
    if send_mode == 'selected' and not get_selected_chats(user_id, account_id):
        try: bot.answer_callback_query(call.id, "❌ Выберите чаты!")
        except: pass
        return
    try: bot.answer_callback_query(call.id, "▶️ Рассылка запущена!")
    except: pass
    mode_labels = {
        'none': '❌ Выключены',
        'hidden': f'👻 Скрытые — {mentions_count}',
        'usernames': f'👤 Юзернеймы — {mentions_count}',
    }
    mentions_str = mode_labels.get(mentions_mode, '❌ Выключены')
    mode_str = "📨 Во все чаты" if send_mode == 'all' else f"📋 Выбранные ({len(get_selected_chats(user_id, account_id))})"
    safe_edit_message_text(f"▶️ <b>Рассылка запущена</b>\n\n⏱ Интервал: {interval} сек.\n👥 Упоминания: {mentions_str}\n📋 Режим: {mode_str}\n\n⏳ Ожидание...", chat_id=call.message.chat.id, message_id=call.message.message_id, reply_markup=stop_keyboard())
    db_query("UPDATE users SET is_running=1 WHERE user_id=?", (user_id,))
    threading.Thread(target=broadcast_worker, args=(user_id, account_id, call.message.chat.id, call.message.message_id), daemon=True).start()

@bot.callback_query_handler(func=lambda call: call.data == "broadcast_stop")
def cb_broadcast_stop(call):
    try: bot.answer_callback_query(call.id, "Останавливаем...")
    except: pass
    user_id = call.from_user.id
    db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
    user_states.pop(user_id, None)
    try:
        safe_edit_message_text("⏹ <b>Рассылка остановлена</b>\n\nОжидайте завершения текущей операции...", chat_id=call.message.chat.id, message_id=call.message.message_id)
    except: pass

def broadcast_worker(user_id, account_id, chat_id, message_id):
    user = get_user(user_id)
    text = user[1] or ""
    interval = user[2] or 1.0
    mentions_mode = user[3] if len(user) > 3 else 'none'
    mentions_count = user[4] if len(user) > 4 else 10
    send_mode = user[5] if len(user) > 5 else 'all'
    acc = get_account(account_id)
    if not acc:
        safe_edit_message_text("❌ <b>Аккаунт не найден</b>", chat_id=chat_id, message_id=message_id)
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        return
    manager.start_client(account_id, acc[2])
    client = manager.get_client(account_id)
    if not client:
        safe_edit_message_text("❌ <b>Клиент не найден</b>", chat_id=chat_id, message_id=message_id)
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        return
    try:
        me = manager.run_sync(account_id, client.get_me(), timeout=30)
        dialogs = manager.run_sync(account_id, fetch_all_group_dialogs(client, me.id), timeout=600)
        if send_mode == 'selected':
            selected = get_selected_chats(user_id, account_id)
            selected_ids = {row[0] for row in selected}
            dialogs = [d for d in dialogs if d.id in selected_ids]
        if not dialogs:
            safe_edit_message_text("❌ <b>Нет чатов для рассылки</b>", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
            db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
            return
        total = len(dialogs)
        sent = 0
        failed = 0
        for idx, dialog in enumerate(dialogs):
            user = get_user(user_id)
            if not user[6]:
                remaining = total - idx
                safe_edit_message_text(f"⏹ <b>Остановлено</b>\n\n📋 Всего: {total}\n✅ Отправлено: {sent}\n❌ Ошибок: {failed}\n📋 Осталось: {remaining}", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
                db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
                return
            entity = dialog.entity
            msg_text = text + FOOTER_TEXT
            if mentions_mode != 'none' and hasattr(entity, 'id'):
                try:
                    participants = manager.run_sync(account_id, client.get_participants(entity, limit=mentions_count), timeout=30)
                    if 'hidden' in mentions_mode:
                        tags = [f'<a href="tg://user?id={p.id}">\u200b</a>' for p in participants if p.id != me.id]
                        if tags:
                            msg_text = text + "\n\n" + "".join(tags) + FOOTER_TEXT
                    elif 'usernames' in mentions_mode:
                        tags = []
                        for p in participants:
                            if p.id == me.id:
                                continue
                            if p.username:
                                tags.append(f"@{p.username}")
                            else:
                                tags.append(f'<a href="tg://user?id={p.id}">\u200b</a>')
                        if tags:
                            msg_text = text + "\n\n" + " ".join(tags) + FOOTER_TEXT
                except Exception:
                    pass
            try:
                manager.run_sync(account_id, client.send_message(entity, msg_text, parse_mode='html'), timeout=30)
                sent += 1
            except FloodWaitError as e:
                try:
                    bot.send_message(user_id, f"⚠️ <b>FloodWait</b>\n\nПодождите {e.seconds} сек...")
                except: pass
                time.sleep(min(e.seconds, 300))
                try:
                    manager.run_sync(account_id, client.send_message(entity, msg_text, parse_mode='html'), timeout=30)
                    sent += 1
                except:
                    failed += 1
            except Exception:
                failed += 1
            if idx % 5 == 0:
                remaining = total - idx - 1
                try:
                    status_text = f"📊 <b>Статус</b>\n\n📋 Всего: {total}\n✅ Отправлено: {sent}\n❌ Ошибок: {failed}\n📋 Осталось: {remaining}\n⏳ {idx+1}/{total}"
                    safe_edit_message_text(status_text, chat_id=chat_id, message_id=message_id, reply_markup=stop_keyboard())
                except: pass
            time.sleep(interval)
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        final_text = f"✅ <b>Рассылка завершена</b>\n\n📋 Всего: {total}\n✅ Отправлено: {sent}\n❌ Ошибок: {failed}"
        safe_edit_message_text(final_text, chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))
    except Exception as e:
        db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
        safe_edit_message_text(f"❌ <b>Ошибка</b>\n\n{str(e)}", chat_id=chat_id, message_id=message_id, reply_markup=main_menu_keyboard(True))

