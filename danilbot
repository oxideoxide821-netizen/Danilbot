        conn.close()
        bot.answer_callback_query(c.id, f"❌ Заявка уже {status}.", show_alert=True)
        return
    
    cur.execute("UPDATE purchases SET status='confirmed' WHERE id=?", (purchase_id,))
    conn.commit()
    conn.close()
    
    try:
        bot.send_message(buyer_id, f"✅ <b>Покупка подтверждена!</b>\n\nТеперь ты можешь оставить отзыв на товар.", parse_mode='HTML')
