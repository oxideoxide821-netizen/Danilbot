@app.post("/api/accounts/import-session")
async def import_session(file: UploadFile = File(...)):
    require_config()
    if not (file.filename or "").lower().endswith(".session"):
        raise HTTPException(400, "Выберите файл Telegram .session")
    idx = next((i for i in range(15) if i not in accounts and not (SESSION_DIR / f"acc_{i}.session").exists()), None)
    if idx is None:
        raise HTTPException(409, "Нет свободного слота аккаунта (максимум 15).")
    session_path = SESSION_DIR / f"acc_{idx}.session"
    try:
        content = await file.read()
        if not content:
            raise HTTPException(400, "Файл сессии пустой.")
        session_path.write_bytes(content)
        client = TelegramClient(str(SESSION_DIR / f"acc_{idx}"), api_id, api_hash)
        await client.connect()
        if not await client.is_user_authorized():
            await client.disconnect()
            session_path.unlink(missing_ok=True)
            raise HTTPException(401, "Сессия не авторизована или несовместима. Проверьте файл и API ID/Hash.")
        me = await client.get_me()
        accounts[idx] = {"client": client, "name": name_of(me)}
        return {"ok": True, "id": idx, "name": accounts[idx]["name"]}
    except HTTPException:
        raise
    except Exception as e:
        try:
            if session_path.exists(): session_path.unlink()
        except Exception: pass
        raise HTTPException(400, f"Не удалось импортировать сессию: {e}")
    finally:
        await file.close()

@app.get("/api/status")
async def status():
    return {"configured": bool(api_id and api_hash),
            "accounts": [{"id": i, "name": a["name"]} for i, a in sorted(accounts.items())]}

@app.post("/api/config")
async def config(data: Config):
    if data.api_id <= 0 or len(data.api_hash.strip()) < 20:
        raise HTTPException(400, "Проверьте API ID и API Hash.")
    if accounts:
        raise HTTPException(409, "Сначала отключите подключённые аккаунты.")
    save_config(data.api_id, data.api_hash)
    return {"ok": True}

@app.post("/api/accounts/{idx}/request-code")
async def request_code(idx: int, data: Phone):
    require_config()
    if not 0 <= idx < 15:
        raise HTTPException(400, "Номер аккаунта должен быть от 0 до 14.")
    if idx in accounts:
        raise HTTPException(409, "Этот слот уже занят подключённым аккаунтом. Отключите его в разделе «Аккаунты».")
    # Повторный запрос кода заменяет незавершённую попытку входа в этом слоте.
    old_pending = pending.pop(idx, None)
    if old_pending:
        try:
            await old_pending["client"].disconnect()
        except Exception:
            pass
    client = TelegramClient(str(SESSION_DIR / f"acc_{idx}"), api_id, api_hash)
    try:
        await client.connect()
        sent = await client.send_code_request(data.phone.strip())
        pending[idx] = {"client": client, "phone": data.phone.strip(), "hash": sent.phone_code_hash}
        return {"ok": True}
    except Exception as e:
        await client.disconnect()
        raise HTTPException(400, str(e))

@app.delete("/api/accounts/{idx}/pending")
async def cancel_pending(idx: int):
    p = pending.pop(idx, None)
