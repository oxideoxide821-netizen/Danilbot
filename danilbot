def settle(uid, bet, gross):
    """
    Единая точка расчёта. gross — сколько игроку возвращается ДО бонусов
    (0 — проигрыш, bet — ничья, больше bet — выигрыш).
    Применяет механику невезения. Возвращает (чистый_итог, [доп. строки]).
    """
    user = get_user(uid)
    streak = user[U_STREAK]
    lines = []

    if gross > bet:  # ---- победа
        profit = gross - bet
        pct = min(streak * LUCK_STEP, LUCK_MAX)
        bonus = int(profit * pct)
        final = gross + bonus
        add_balance(uid, final)
        db_query("UPDATE users SET wins=wins+1, games=games+1, earned=earned+?, loss_streak=0 "
                 "WHERE user_id=?", (final - bet, uid))
        if bonus:
            lines.append("Бонус невезения: +{} (+{}% за {} поражений подряд)".format(
                fmt(bonus), int(pct * 100), streak))
        net = final - bet

    elif gross == bet:  # ---- ничья
        add_balance(uid, bet)
        db_query("UPDATE users SET games=games+1 WHERE user_id=?", (uid,))
        net = 0

    else:  # ---- поражение (возможно, частичное)
        if gross > 0:
            add_balance(uid, gross)
        new_streak = streak + 1
        db_query("UPDATE users SET losses=losses+1, games=games+1, loss_streak=?, "
                 "best_streak=MAX(best_streak, ?) WHERE user_id=?", (new_streak, new_streak, uid))
        add_jackpot(max(1, int((bet - gross) * JACKPOT_CUT)))
        net = gross - bet
        if new_streak % CASHBACK_EVERY == 0:
            cashback = max(1, int(bet * CASHBACK_PCT))
            add_balance(uid, cashback)
            net += cashback
            lines.append("Утешение за {} поражений подряд: кэшбэк +{}".format(new_streak, fmt(cashback)))
        next_pct = min(new_streak * LUCK_STEP, LUCK_MAX)
        lines.append("Серия поражений: {}. Бонус к следующему выигрышу: +{}%".format(
            new_streak, int(next_pct * 100)))

    # ---- опыт и уровни
    xp_gain = max(1, bet // 20)
    old_level = level_of(user[U_XP])
    db_query("UPDATE users SET xp=xp+? WHERE user_id=?", (xp_gain, uid))
    new_level = level_of(user[U_XP] + xp_gain)
    if new_level > old_level:
        reward = new_level * 200
        add_balance(uid, reward)
        lines.append("Новый уровень {} ({})! Награда: +{}".format(new_level, title_of(new_level), fmt(reward)))
    return net, lines


def compose(head, net, lines):
    if net > 0:
        res = "Итог: +{}".format(fmt(net))
    elif net < 0:
        res = "Итог: -{}".format(fmt(-net))
    else:
        res = "Итог: ставка возвращена"
    return "\n".join([head, res] + lines)


