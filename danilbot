async def fetch_all_group_dialogs(client, me_id):
    result = []
    async for dialog in client.iter_dialogs():
        if dialog.id == me_id:
            continue
        entity = dialog.entity
        if entity is None:
            continue
        if isinstance(entity, types.Chat):
            result.append(dialog)
        elif isinstance(entity, types.Channel) and getattr(entity, 'megagroup', False):
            result.append(dialog)
    return result

# ================== PHONE AUTH MANAGER ==================
class PhoneAuthManager:
    def __init__(self):
        self.pending = {}

    def start_auth(self, user_id, chat_id, bot_instance):
        if user_id in self.pending:
            bot_instance.send_message(chat_id, "⏳ Авторизация уже идёт.")
            return
        self.pending[user_id] = {
            'chat_id': chat_id,
            'phone': None,
            'client': None,
            'loop': None,
            'code_event': threading.Event(),
            'code_value': None,
            'password_event': threading.Event(),
            'password_value': None,
            'cancelled': False
        }
        bot_instance.send_message(
            chat_id,
            "📱 <b>Авторизация по номеру</b>\n\n"
            "Введите номер телефона в формате <code>+79991234567</code>:",
            reply_markup=cancel_auth_keyboard()
        )
        user_states[user_id] = 'phone_input'

    def submit_phone(self, user_id, phone):
        if user_id not in self.pending or self.pending[user_id].get('cancelled'):
            return False
        self.pending[user_id]['phone'] = phone
        t = threading.Thread(target=self._auth_thread, args=(user_id,), daemon=True)
        t.start()
        return True

    def submit_code(self, user_id, code):
        if user_id in self.pending and not self.pending[user_id].get('cancelled'):
            self.pending[user_id]['code_value'] = code
            self.pending[user_id]['code_event'].set()
            return True
        return False

    def submit_password(self, user_id, password):
        if user_id in self.pending and not self.pending[user_id].get('cancelled'):
            self.pending[user_id]['password_value'] = password
            self.pending[user_id]['password_event'].set()
            return True
        return False

    def cancel(self, user_id):
        if user_id in self.pending:
            self.pending[user_id]['cancelled'] = True
            self.pending[user_id]['code_event'].set()
            self.pending[user_id]['password_event'].set()
            p = self.pending[user_id]
            if p.get('client') and p.get('loop'):
                try:
                    asyncio.run_coroutine_threadsafe(p['client'].disconnect(), p['loop']).result(timeout=5)
                except:
                    pass
            del self.pending[user_id]
            return True
        return False

    def _auth_thread(self, user_id):
        p = self.pending[user_id]
        phone = p['phone']
        chat_id = p['chat_id']
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        session = StringSession()
        client = TelegramClient(session, API_ID, API_HASH, loop=loop)
        p['client'] = client
        p['loop'] = loop

        async def do_auth():
            try:
                await client.connect()
                await client.send_code_request(phone)
                bot.send_message(
                    chat_id,
                    f"📩 Код отправлен на <code>{phone}</code>\n\nВведите код подтверждения:",
                    reply_markup=cancel_auth_keyboard()
                )
                user_states[user_id] = 'phone_code_input'
                p['code_event'].wait()
                if p['cancelled']:
                    return
                raw_code = p['code_value']
                clean_code = raw_code.replace('.', '').replace(' ', '').replace('-', '')
                try:
                    await client.sign_in(phone, clean_code)
                except SessionPasswordNeededError:
                    bot.send_message(
                        chat_id,
                        "🔒 <b>Требуется пароль 2FA</b>\n\nВведите пароль от аккаунта:",
                        reply_markup=cancel_auth_keyboard()
                    )
                    user_states[user_id] = 'phone_2fa_input'
                    p['password_event'].wait()
                    if p['cancelled']:
                        return
                    password = p['password_value']
                    await client.sign_in(password=password)
                if await client.is_user_authorized():
                    me = await client.get_me()
                    ss = client.session.save()
                    db_query("UPDATE users SET session_string=?, auth_step='done' WHERE user_id=?", (ss, user_id))
                    user_states.pop(user_id, None)
                    name = me.first_name + (f" {me.last_name}" if me.last_name else "")
                    bot_instance = bot
                    bot_instance.send_message(
                        chat_id,
                        f"✅ <b>Авторизация успешна!</b>\n\n"
                        f"👤 Аккаунт: {name}\n"
                        f"📱 Телефон: <code>{me.phone or 'не указан'}</code>\n\n"
                        f"Теперь вы можете настроить рассылку.",
                        reply_markup=main_menu_keyboard(True)
                    )
                else:
                    bot.send_message(chat_id, "❌ Авторизация не удалась.", reply_markup=main_menu_keyboard(False))
            except Exception as e:
                bot.send_message(chat_id, f"❌ Ошибка: {str(e)}", reply_markup=main_menu_keyboard(False))
            finally:
                try:
                    await client.disconnect()
                except:
                    pass
                if user_id in self.pending:
                    del self.pending[user_id]

        loop.run_until_complete(do_auth())

