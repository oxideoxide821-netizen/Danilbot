    cur.execute("SELECT seller_id, title FROM items WHERE id=?", (item_id,))
    row = cur.fetchone()
    cur.execute("DELETE FROM items WHERE id=?", (item_id,))
    # Удаляем связанные видео
    cur.execute("DELETE FROM item_videos WHERE item_id=?", (item_id,))
    conn.commit()
    conn.close()
    if row:
        try:
            bot.send_message(row[0], f"❌ Твой товар <b>{row[1]}</b> отклонён модератором.", parse_mode='HTML')
        except: pass
    bot.edit_message_text(f"❌ Товар ID <code>{item_id}</code> отклонён.", c.message.chat.id, c.message.message_id, parse_mode='HTML')

