@app.get("/api/accounts/{idx}/dialogs/{peer}/messages")
async def get_messages(idx: int, peer: int):
    a = acc_or_404(idx)
    try:
        entity = await a["client"].get_input_entity(peer)
        ms = await a["client"].get_messages(entity, limit=60)
        result = []
        for m in reversed(ms):
            mime = getattr(getattr(m, "file", None), "mime_type", None) or ""
            media_kind = ""
            if mime.startswith("video/"):
                media_kind = "video"
            elif mime.startswith("image/"):
                media_kind = "image"
            elif "tgsticker" in mime or "webm" in mime:
                media_kind = "sticker"
            elif m.media:
                media_kind = "file"
            reply_preview = ""
            if m.reply_to_msg_id:
                try:
                    replied = await m.get_reply_message()
                    if replied:
                        reply_preview = (replied.message or "[Медиа]")[:100]
                except Exception:
                    pass
            sender = None
            try:
                sender_obj = await m.get_sender()
                if sender_obj:
                    sender_name = " ".join(x for x in [getattr(sender_obj, "first_name", ""), getattr(sender_obj, "last_name", "")] if x) or getattr(sender_obj, "title", "") or "Пользователь"
                    sender = {"id": sender_obj.id, "name": sender_name,
                              "username": getattr(sender_obj, "username", None),
                              "is_bot": bool(getattr(sender_obj, "bot", False))}
            except Exception:
                pass
            result.append({
                "id": m.id,
                "sender": sender,
                "text": m.message or ("[Стикер]" if media_kind == "sticker" else "[Медиа]" if m.media else ""),
                "out": bool(m.out),
                "date": m.date.isoformat() if m.date else "",
                "media_kind": media_kind,
                "media_url": f"/api/accounts/{idx}/dialogs/{peer}/messages/{m.id}/media" if m.media else "",
                "reply_to": m.reply_to_msg_id,
                "reply_preview": reply_preview
            })
        return result
    except Exception as e:
        raise HTTPException(400, str(e))

