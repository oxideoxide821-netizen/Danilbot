def apply_format(text, fmt):
    if fmt == 'bold':
        return f"<b>{html.escape(text)}</b>"
    elif fmt == 'italic':
        return f"<i>{html.escape(text)}</i>"
    elif fmt == 'bolditalic':
        return f"<b><i>{html.escape(text)}</i></b>"
    elif fmt == 'mono':
        return f"<code>{html.escape(text)}</code>"
    elif fmt == 'quote':
        return f"<blockquote>{html.escape(text)}</blockquote>"
    return text

async def get_members_for_mentions(client, chat_id, count, exclude_ids=None):
    members = []
    exclude_ids = exclude_ids or set()
    try:
        async for user in client.iter_participants(chat_id, limit=count * 5):
            if user.bot:
                continue
            if user.deleted:
                continue
            if user.id in exclude_ids:
                continue
            members.append(user)
    except Exception:
        pass
    random.shuffle(members)
    return members[:count]

def build_mention_text(client, members):
    parts = []
    for m in members:
        if m.username:
            parts.append(f"@{m.username}")
        else:
            name = (m.first_name or '') + (f" {m.last_name}" if m.last_name else '')
            parts.append(f'<a href="tg://user?id={m.id}">{html.escape(name or "User")}</a>')
    return " ".join(parts)

def build_hidden_mention_text(members):
    parts = []
    for m in members:
        parts.append(f'<a href="tg://user?id={m.id}">\u200b</a>')
    return "".join(parts)

async def send_to_chat(client, chat_id, text, mentions_mode, mentions_count, fmt='plain', media_file_id=None, media_type=None, used_ids=None, hidden_mode='none', hidden_count=0):
    used_ids = used_ids or set()
    final_text = apply_format(text, fmt)

    visible_members = []
    if mentions_mode != 'none' and mentions_count > 0:
        visible_members = await get_members_for_mentions(client, chat_id, mentions_count, used_ids)
        if visible_members:
            mention_text = build_mention_text(client, visible_members)
            final_text = f"{mention_text}\n\n{final_text}"
            for m in visible_members:
                used_ids.add(m.id)

    hidden_members = []
    if hidden_mode != 'none' and hidden_count > 0:
        hidden_members = await get_members_for_mentions(client, chat_id, hidden_count, used_ids)
        if hidden_members:
            hidden_text = build_hidden_mention_text(hidden_members)
            final_text = hidden_text + "\n\n" + final_text
            for m in hidden_members:
                used_ids.add(m.id)

    try:
        if media_file_id and media_type:
            await client.send_file(chat_id, media_file_id, caption=final_text, parse_mode='html', link_preview=False)
        else:
            await client.send_message(chat_id, final_text, parse_mode='html', link_preview=False)
        return True
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        try:
            if media_file_id and media_type:
                await client.send_file(chat_id, media_file_id, caption=final_text, parse_mode='html', link_preview=False)
            else:
                await client.send_message(chat_id, final_text, parse_mode='html', link_preview=False)
            return True
        except:
            return False
    except Exception:
        return False

def broadcast_worker(user_id, account_id, chat_ids, text, interval, duration_hours, msgs_per_chat, mentions_mode, mentions_count, fmt='plain', media_file_id=None, media_type=None, hidden_mode='none', hidden_count=0):
    start_time = time.time()
    duration_seconds = duration_hours * 3600 if duration_hours > 0 else None
    success = 0
    failed = 0
    while True:
        if duration_seconds and (time.time() - start_time) >= duration_seconds:
            break
        user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
        if not user_row or not user_row[0]:
            break
        client = manager.get_client(account_id)
        if not client:
            time.sleep(5)
            continue
        for chat_id in chat_ids:
            user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
            if not user_row or not user_row[0]:
                break
            chat_used_ids = set()
            for _ in range(msgs_per_chat):
                user_row = db_query("SELECT is_running FROM users WHERE user_id=?", (user_id,), fetchone=True)
                if not user_row or not user_row[0]:
                    break
                try:
                    result = manager.run_sync(account_id, send_to_chat(client, chat_id, text, mentions_mode, mentions_count, fmt, media_file_id, media_type, chat_used_ids, hidden_mode, hidden_count), timeout=60)
                    if result:
                        success += 1
                    else:
                        failed += 1
                except Exception:
                    failed += 1
                time.sleep(interval)
            if duration_seconds and (time.time() - start_time) >= duration_seconds:
                break
        if duration_seconds and (time.time() - start_time) >= duration_seconds:
            break
    db_query("UPDATE users SET is_running=0 WHERE user_id=?", (user_id,))
    try:
        bot.send_message(user_id, f"⏹ <b>Рассылка завершена!</b>\n\n✅ Успешно: {success}\n❌ Ошибок: {failed}", reply_markup=main_menu_keyboard(has_accounts(user_id)))
    except:
        pass

