def do_farm(user_id, username, chat_id, message_id=None):
    user = get_user(user_id, username)
    now = int(time.time())
    last_farm = user[15]

    if now - last_farm < FARM_COOLDOWN:
        wait = FARM_COOLDOWN - (now - last_farm)
        mins, secs = divmod(wait, 60)
        text = f"⏳ Подожди ещё *{mins}м {secs}с* перед следующим сбором!"
        if message_id:
            safe_edit(chat_id, message_id, text, back_button(user_id))
        else:
            bot.send_message(chat_id, text, parse_mode="Markdown", reply_markup=back_button(user_id))
        return

    farm_power = user[13]
    leg_chance = user[14]

    grass_amount = random.randint(1, 3) * farm_power
    rare_amount = random.randint(0, 2) * farm_power
    leg_roll = random.randint(1, 100)
    leg_amount = 0
    if leg_roll <= (5 + leg_chance):
        leg_amount = random.randint(1, 2) * farm_power

    add_field(user_id, "grass", grass_amount)
    add_field(user_id, "rare_grass", rare_amount)
    add_field(user_id, "legendary_grass", leg_amount)
    update_user(user_id, "last_farm", now)

    text = f"""🌿 *Сбор травы завершён!*

🌱 Обычной травы: +{grass_amount}
⭐ Редкой травы: +{rare_amount}
💎 Легендарной травы: +{leg_amount}

💪 Сила сбора: x{farm_power}"""
    if message_id:
        safe_edit(chat_id, message_id, text, back_button(user_id))
    else:
        bot.send_message(chat_id, text, parse_mode="Markdown", reply_markup=back_button(user_id))

