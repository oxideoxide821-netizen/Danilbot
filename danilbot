@bot.callback_query_handler(func=lambda c: c.data == 'confirm_sell')
def cb_confirm_sell(c):
    bot.answer_callback_query(c.id)
    uid = c.from_user.id
    d = user_data.get(uid, {})
    if not d:
        return
    
    conn = get_db()
    cur = conn.cursor()
    cur.execute("""INSERT INTO items (seller_id, seller_name, title, description, price, category, status, created_at)
                   VALUES (?,?,?,?,?,?,'pending',?)""",
                (uid, c.from_user.username or c.from_user.first_name, d['title'], d['desc'], d['price'],
                 d['cat'], datetime.now().strftime("%Y-%m-%d %H:%M")))
    item_id = cur.lastrowid
    
    for vid in d.get('videos', []):
        cur.execute("INSERT INTO item_videos (item_id, file_id) VALUES (?,?)", (item_id, vid))
    
    conn.commit()
    conn.close()
    
    cat_name = CATEGORIES.get(d['cat'], d['cat'])
    admin_txt = (f"🆕 <b>Новый товар на модерацию!</b>\n\n"
                 f"📦 {d['title']}\n"
                 f"📝 {d['desc'][:200]}...\n"
                 f"💵 {d['price']} руб.\n"
                 f"🏷 {cat_name}\n"
                 f"👤 @{c.from_user.username or c.from_user.first_name} (ID: <code>{uid}</code>)\n"
                 f"🎥 Видео: {len(d.get('videos', []))} шт.\n\n"
                 f"ID: <code>{item_id}</code>")
    for admin in ADMINS:
        try:
            bot.send_message(admin, admin_txt, reply_markup=kb_mod(item_id), parse_mode='HTML')
        except Exception as e:
            logger.error(f"Admin {admin} notify failed: {e}")
    
    bot.edit_message_text("✅ Товар отправлен на модерацию! После проверки он появится в маркетплейсе.\n\nСпасибо! 🚀",
                          c.message.chat.id, c.message.message_id, reply_markup=kb_main())
    user_state.pop(uid, None)
    user_data.pop(uid, None)

