def show_top(chat_id, top_type, owner_id, message_id=None):
    with db_lock:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        if top_type == "smokers":
            c.execute("SELECT username, total_smoked FROM users ORDER BY total_smoked DESC LIMIT 10")
            title = "🏆 *Топ курильщиков*"
        elif top_type == "high":
            c.execute("SELECT username, total_high FROM users ORDER BY total_high DESC LIMIT 10")
            title = "🌀 *Топ кайфариков*"
        else:
            c.execute("SELECT username, balance FROM users ORDER BY balance DESC LIMIT 10")
            title = "💎 *Топ богачей*"
        rows = c.fetchall()
        conn.close()

    text = title + "\n\n"
    medals = ["🥇", "🥈", "🥉", "4️⃣", "5️⃣", "6️⃣", "7️⃣", "8️⃣", "9️⃣", "🔟"]
    for i, (uname, val) in enumerate(rows):
        name = uname or "Безымянный"
        text += f"{medals[i]} {name} — {val:,}\n"
    if not rows:
        text += "Пока никого нет..."

    if message_id:
        safe_edit(chat_id, message_id, text, tops_menu(owner_id))
    else:
        bot.send_message(chat_id, text, parse_mode="Markdown", reply_markup=tops_menu(owner_id))

