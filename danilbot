           f"📅 {created}\n\n"
           f"💬 <b>Отзывы:</b>\n{reviews}\n\n"
           f"🎥 Видео: {len(videos)} шт.")
    
    kb = kb_item(item_id, page)
    
    if videos:
        clear_item_messages(uid, c.message.chat.id)
        bot.delete_message(c.message.chat.id, c.message.message_id)
        msg = bot.send_video(c.message.chat.id, videos[0], caption=txt, reply_markup=kb, parse_mode='HTML')
        user_item_msg[uid] = msg.message_id
        if len(videos) > 1:
            sent_ids = []
            for vid in videos[1:]:
