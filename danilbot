def parse_amount(text):
    if not text:
        return None
    text = text.lower().replace(" ", "")
    mult = 1
    if text.endswith("к") or text.endswith("k"):
        mult = 1000
        text = text[:-1]
    try:
        return int(float(text) * mult)
    except ValueError:
