@bot.message_handler(commands=["admin_give"])
def admin_give(message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        parts = message.text.split()
        target = int(parts[1])
        amount = int(parts[2])
        field = parts[3] if len(parts) > 3 else "balance"
        if field not in VALID_FIELDS:
            bot.reply_to(message, "❌ Недопустимое поле!")
            return
        if amount > MAX_SAFE_INT:
            amount = MAX_SAFE_INT
        add_field(target, field, amount)
        bot.reply_to(message, f"✅ Выдано {amount:,} {field} пользователю {target}")
    except Exception as e:
        bot.reply_to(message, f"❌ Ошибка: {e}")

@bot.message_handler(commands=["admin_give_all"])
def admin_give_all(message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        parts = message.text.split()
        amount = int(parts[1]) if len(parts) > 1 else 100_000_000_000_000
        field = parts[2] if len(parts) > 2 else "balance"
        if field not in VALID_FIELDS:
            bot.reply_to(message, "❌ Недопустимое поле!")
            return
        if amount > MAX_SAFE_INT:
            amount = MAX_SAFE_INT
        with db_lock:
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute(f"UPDATE users SET {field} = CASE WHEN {field} + ? > {MAX_SAFE_INT} THEN {MAX_SAFE_INT} ELSE {field} + ? END", (amount, amount))
            conn.commit()
            conn.close()
        bot.reply_to(message, f"✅ Выдано {amount:,} {field} всем пользователям!")
    except Exception as e:
        bot.reply_to(message, f"❌ Ошибка: {e}")

# ==================== ИИ ЧАТ ====================
def ai_reply(message_text, user_name, chat_history=None):
    """Отправляет запрос к OpenRouter и возвращает ответ ИИ"""
    try:
        headers = {
            "Authorization": f"Bearer {OPENROUTER_API_KEY}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://t.me/travka_bot",
            "X-Title": "Травка Бот"
        }

        messages = [{"role": "system", "content": AI_SYSTEM_PROMPT}]

        if chat_history:
            messages.extend(chat_history)

        messages.append({"role": "user", "content": f"{user_name}: {message_text}"})

        payload = {
            "model": OPENROUTER_MODEL,
            "messages": messages,
            "max_tokens": 200,
            "temperature": 0.9
        }

        response = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers=headers,
            json=payload,
            timeout=15
        )

        if response.status_code == 200:
            data = response.json()
            if "choices" in data and len(data["choices"]) > 0:
                reply = data["choices"][0]["message"]["content"].strip()
                return reply
        return None
    except Exception as e:
        print(f"[AI ERROR] {e}")
        return None

@bot.message_handler(func=lambda m: m.text and not m.text.startswith("/") and not m.text.lower().startswith(("передать", "дать", "продать", "купить")), content_types=["text"])
def ai_chat_handler(message):
    """ИИ отвечает на сообщения с определённым шансом"""
    # Не отвечаем на свои сообщения
    if message.from_user.id == get_bot_id():
        return

    # Не отвечаем если это команда бота
    text_lower = message.text.lower().strip()
    bot_commands = ["сбор", "собрать", "фарм", "собирать", "крафт", "скрафтить", "крафтить",
                    "кури", "курить", "дымить", "закурить", "топ", "топы", "лидеры",
                    "профиль", "баланс", "я", "стата", "статистика", "инвентарь", "инв", "рюкзак",
                    "ежедневный", "бонус", "daily", "награда", "магазин", "shop", "торговля",
                    "помощь", "help", "команды", "старт", "start"]
    if text_lower in bot_commands:
        return

    # Шанс ответа
    if random.random() > AI_REPLY_CHANCE:
        return

    user_name = message.from_user.first_name or message.from_user.username or "Друг"
    reply_text = ai_reply(message.text, user_name)

    if reply_text:
        try:
            bot.reply_to(message, reply_text, parse_mode="Markdown")
        except:
            bot.reply_to(message, reply_text)

